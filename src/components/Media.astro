---
import Icon from './Icon.astro';
import { url, duration, type Media } from '../lib/posts';
interface Props { items: Media[]; alt: string; eager?: boolean; fallbackHref?: string }
const { items, alt, eager = false, fallbackHref } = Astro.props;
const shown = items.slice(0, 4);
const n = shown.length;
const hasVideo = shown.some((m) => m.type === 'video');
---
{
  n > 0 && (
    <div class="media-wrap">
      <div class={`media n${n}`}>
        <button class="reveal" type="button">
          <Icon name={hasVideo ? 'play' : 'image'} />
          {hasVideo ? 'نمایش ویدیو' : n > 1 ? `نمایش ${n.toLocaleString('fa-IR')} تصویر` : 'نمایش تصویر'}
        </button>
        {shown.map((m, i) =>
          m.type === 'image' ? (
            <figure>
              <img
                src={url(m.src!)}
                alt={n > 1 ? `${alt} — تصویر ${(i + 1).toLocaleString('fa-IR')}` : alt}
                width={m.width}
                height={m.height}
                loading={eager && i === 0 ? 'eager' : 'lazy'}
                fetchpriority={eager && i === 0 ? 'high' : undefined}
                decoding="async"
              />
            </figure>
          ) : m.src ? (
            <figure>
              <video
                src={url(m.src)}
                poster={m.poster ? url(m.poster) : undefined}
                width={m.width}
                height={m.height}
                controls
                playsinline
                preload="none"
                autoplay={m.gif}
                loop={m.gif}
                muted={m.gif}
                aria-label={`ویدیو: ${alt}`}
              />
              {m.duration && !m.gif && <span class="badge" data-num>{duration(m.duration)}</span>}
            </figure>
          ) : (
            <figure>
              <a class="vid-link" href={m.remote || fallbackHref} target="_blank" rel="noopener" aria-label="دیدن ویدیو در منبع اصلی">
                <img src={url(m.poster!)} alt={alt} width={m.width} height={m.height} loading={eager ? 'eager' : 'lazy'} decoding="async" />
                <span class="play"><span><Icon name="play" /></span></span>
              </a>
              <span class="badge">ویدیو در منبع اصلی</span>
            </figure>
          ),
        )}
      </div>
    </div>
  )
}
