---
// Offered on the home page once a reader has read a few stories (src/scripts/notify.ts decides): one slim line — turn
// on notifications of new stories, or not now (asked again a month later). Never on a first visit, never a prompt on arrival.
import Icon from './Icon.astro';
---
<aside class="notify-ask" data-notify-ask hidden aria-labelledby="notify-ask-title">
  <Icon name="bell" class="notify-ask-icon" />
  <b id="notify-ask-title" class="notify-ask-text">خبر تازه را همان لحظه بگیرید</b>
  <button class="btn sm primary" type="button" data-notify-yes>روشن کن</button>
  <button class="icon-btn notify-no" type="button" data-notify-no aria-label="نه، ممنون" title="نه، ممنون"><Icon name="x" /></button>
</aside>
