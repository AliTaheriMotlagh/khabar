---
import Icon from './Icon.astro';
import { SITE } from '../site';
import { url } from '../lib/posts';
const path = Astro.url.pathname;
const here = (p: string) => (p === url() ? path === p || /\/page\/\d+\/$/.test(path) : path.startsWith(p)) ? 'page' : undefined;
const nav = [
  { href: url(), label: 'خانه', icon: 'home' },
  { href: url('today/'), label: 'امروز در یک نگاه', icon: 'stories' },
  { href: url('tags/'), label: 'موضوع‌ها', icon: 'hash' },
  { href: url('saved/'), label: 'ذخیره‌ها', icon: 'bookmark' },
  { href: url('about/'), label: 'درباره', icon: 'info' },
];
---
<header class="site-header" data-header>
  <div class="container bar">
    <a class="brand" href={url()} aria-label={`${SITE.name} — صفحه‌ی اصلی`}>
      <span class="logo-mark" aria-hidden="true"></span>
      <span class="brand-text"><b>{SITE.name}</b><small>{SITE.nameLatin}</small></span>
    </a>
    <nav class="main-nav" aria-label="ناوبری اصلی">
      {nav.map((n) => <a href={n.href} aria-current={here(n.href)}>{n.label}</a>)}
    </nav>
    <div class="tools">
      <button class="online-pill" type="button" data-open-chat data-online-pill hidden aria-label="گفتگوی زنده">
        <span class="pulse" aria-hidden="true"></span><span data-online>…</span><span class="hide-sm">آنلاین</span>
      </button>
      <a class="icon-btn" href={url('search/')} aria-label="جستجو" title="جستجو (/)"><Icon name="search" /></a>
      <button class="icon-btn" type="button" data-open-chat aria-label="گفتگوی زنده" title="گفتگوی زنده">
        <Icon name="chat" /><span class="dot" data-chat-dot hidden></span>
      </button>
      <button class="icon-btn hide-sm" type="button" data-theme-toggle aria-label="روشن / تیره" title="روشن / تیره (t)">
        <Icon name="moon" class="if-light" /><Icon name="sun" class="if-dark" />
      </button>
      <button class="icon-btn" type="button" data-open-settings aria-label="تنظیمات نمایش" title="تنظیمات نمایش"><Icon name="settings" /></button>
      <a class="me-btn hide-sm" href={url('me/')} aria-label="پروفایل مهمان شما">
        <span class="avatar" data-my-avatar aria-hidden="true">؟</span>
        <span class="lvl" data-my-level-badge></span>
      </a>
    </div>
  </div>
</header>

<nav class="tabbar" aria-label="ناوبری پایین">
  <a href={url()} aria-current={here(url())}><Icon name="home" /><span>خانه</span></a>
  <a href={url('tags/')} aria-current={here(url('tags/'))}><Icon name="hash" /><span>موضوع‌ها</span></a>
  <a class="tab-today" href={url('today/')} aria-current={here(url('today/'))}><Icon name="stories" /><span>امروز</span></a>
  <a href={url('saved/')} aria-current={here(url('saved/'))}><Icon name="bookmark" /><span>ذخیره‌ها</span></a>
  <a href={url('me/')} aria-current={here(url('me/'))}><Icon name="user" /><span>من</span></a>
</nav>
