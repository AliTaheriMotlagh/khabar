---
// The home page's first screen, both editions: one quiet dateline — the newest news day (static text, so nothing moves
// once scripts run), the live dot and when it was last updated, and the slot: the stories circle and today's podcast on
// the Persian home — then the news itself: the lead story large and the top stories beside it (src/lib/front.ts).
// No banner, no numbers: the first screen is news.
import { SITE } from '../site';
import { faDate, faTime, getStories, pic } from '../lib/posts';
import { EN, enDate, enTime } from '../lib/en';
import type { FrontItem } from '../lib/front';
interface Props { lang?: 'fa' | 'en'; lead?: FrontItem; top?: FrontItem[] }
const { lead, top = [] } = Astro.props;
const en = Astro.props.lang === 'en';
const newest = getStories()[0];
const time = (iso: string) => (en ? enTime(iso) : faTime(iso));
const day = newest ? (en ? enDate(newest.date, { weekday: 'long', month: 'long', day: 'numeric' }) : faDate(newest.date, { weekday: 'long', day: 'numeric', month: 'long' })) : '';
const T = en
  ? { live: 'Live', updated: 'updated', top: 'Top stories', leadLabel: 'Top story', must: 'Key' }
  : { live: 'زنده', updated: 'به‌روز', top: 'مهم‌ترین‌ها', leadLabel: 'خبر اول', must: 'مهم' };
---
<section class="front" aria-labelledby="front-h">
  <header class="front-line">
    <div class="front-date">
      <h1 class="front-h" id="front-h">
        <span class="sr-only">{en ? EN.name : SITE.name} — </span>
        {newest ? day : en ? EN.tagline : SITE.tagline}
      </h1>
      {newest && <p class="front-live"><span class="live-dot" aria-hidden="true"></span>{T.live} · {T.updated} <time datetime={newest.date} data-f="rel">{time(newest.date)}</time></p>}
    </div>
    {Astro.slots.has('default') && <div class="front-acts"><slot /></div>}
  </header>
  {
    lead && (
      <div class="front-grid">
        <article class:list={['lead-main', !lead.cover && 'no-img']} data-id={lead.id} aria-label={T.leadLabel}>
          {lead.cover && (
            <div class="lead-media">
              <img {...pic(lead.cover, 'large')} alt="" width="1280" height="720" loading="eager" fetchpriority="high" decoding="async" referrerpolicy="no-referrer" data-fallback={lead.fallback} />
            </div>
          )}
          <div class="lead-body">
            <p class="lead-meta">
              {lead.kicker && <a class="kicker" href={lead.kicker.href}>{lead.kicker.label}</a>}
              {lead.rumor && <span class="status is-rumor" title={lead.rumor.title}>{lead.rumor.label}</span>}
              {lead.by && <span class="lead-by">{lead.by}</span>}
              <time datetime={lead.date} data-f="rel">{time(lead.date)}</time>
            </p>
            <h2><a href={lead.href}>{lead.title}</a></h2>
            {lead.excerpt && <p class="excerpt" dir="auto">{lead.excerpt}</p>}
          </div>
        </article>
        {
          top.length > 0 && (
            <section class="front-top" aria-labelledby="front-top-title">
              <h2 id="front-top-title">{T.top}</h2>
              <ol>
                {top.map((t) => (
                  <li data-id={t.id}>
                    <p class="ft-meta">
                      {t.kicker && <span class="ft-kicker">{t.kicker.label}</span>}
                      {t.rumor && <span class="status is-rumor" title={t.rumor.title}>{t.rumor.label}</span>}
                      {t.must && !t.rumor && <span class="ft-must">{T.must}</span>}
                      <time datetime={t.date} data-f="rel">{time(t.date)}</time>
                    </p>
                    <h3><a href={t.href} data-astro-prefetch>{t.title}</a></h3>
                  </li>
                ))}
              </ol>
            </section>
          )
        }
      </div>
    )
  }
</section>
