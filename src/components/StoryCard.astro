---
// One entry on the timeline: topic, time, headline, a short excerpt and one picture. Reactions live on the story page.
// In the short "list" view it collapses to a linked headline row. On a topic's page (`topic`) the kicker names that
// topic: a story filed under several shows the one the reader is browsing, not its main one.
import Icon from './Icon.astro';
import Media from './Media.astro';
import SaveButton from './SaveButton.astro';
import DigestCard from './DigestCard.astro';
import { faTime, fresh, sized, tagHref, type Post } from '../lib/posts';
interface Props { post: Post; eager?: boolean; topic?: string }
const { post, eager = false, topic } = Astro.props;
const a = post.article;
const tag = topic && a.tags.includes(topic) ? topic : a.tags[0];
const thumb = post.cover ? sized(post.cover.src || post.cover.poster, 'small') : '';
const thumbFresh = fresh(post.cover?.src || post.cover?.poster);
---
<li class="tl-item" data-id={post.id} data-kind={post.kind}>
  <span class="tl-dot" aria-hidden="true"></span>
  <time class="tl-time" datetime={post.date} data-num>{faTime(post.date)}</time>
  {
    post.kind === 'digest' ? (
      <DigestCard post={post} limit={3} />
    ) : (
      <article class="story" aria-labelledby={`t-${post.id}`}>
        {thumb && <img class="row-thumb" src={thumb} alt="" width="72" height="72" loading="lazy" decoding="async" referrerpolicy="no-referrer" data-fresh={thumbFresh} />}
        <div class="story-main">
          <div class="story-head">
            {tag && <a class="kicker" href={tagHref(tag)}>{tag}</a>}
            <time class="story-time" datetime={post.date} data-num>{faTime(post.date)}</time>
          </div>
          <h3 id={`t-${post.id}`}><a href={post.href} data-astro-prefetch>{a.title}</a></h3>
          {post.excerpt && post.excerpt !== a.title && <p class="excerpt" dir="auto">{post.excerpt}</p>}
        </div>
        {post.gallery.length > 0 ? (
          <Media items={post.gallery} alt={a.title} href={post.href} fallbackHref={post.url} limit={1} size="small" eager={eager} maxRatio={0.75} />
        ) : (
          post.cover && (
            <a class="story-cover" href={post.href} tabindex="-1" aria-hidden="true">
              <img src={thumb} alt="" loading={eager ? 'eager' : 'lazy'} decoding="async" referrerpolicy="no-referrer" data-fallback={post.url} data-fresh={thumbFresh} />
            </a>
          )
        )}
        <footer class="story-foot">
          <a class="meta-btn" href={`${post.href}#comments`} aria-label="نظرها">
            <Icon name="comment" /><span data-ccount={post.id}></span>
          </a>
          <span class="meta-btn views" data-views={post.id} title="بازدید (هر نفر یک بار در ۲۴ ساعت)" hidden><Icon name="eye" /><span></span></span>
          <div class="actions">
            <SaveButton post={post} />
            <button class="icon-btn" type="button" data-share data-url={post.href} data-title={a.title} aria-label="اشتراک‌گذاری"><Icon name="share" /></button>
          </div>
        </footer>
      </article>
    )
  }
</li>
