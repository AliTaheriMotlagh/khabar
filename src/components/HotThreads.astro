---
// «پرونده‌های داغ» in the home page's side column (PLAN.md P3-1): the threads still moving — stories that follow one
// subject over days (data/related.json threads) whose newest story is from the last few days. Each line opens that
// newest story at its timeline. Nothing shows without at least two such threads: one line isn't a shelf.
import Icon from './Icon.astro';
import { faDate, faNum } from '../lib/posts';
import { activeThreads, threadName } from '../lib/tracker';
const items = activeThreads().slice(0, 4);
---
{
  items.length >= 2 && (
    <section class="side-card hot" aria-labelledby="hot-h">
      <h2 class="side-title" id="hot-h"><Icon name="flame" /> پرونده‌های داغ</h2>
      <ol class="hot-list">
        {items.map(({ thread, posts, newest }) => (
          <li>
            <a href={`${newest.href}#thread`}>
              <b>{threadName(thread, posts)}</b>
              <small><span data-num>{faNum(posts.length)}</span> خبر · <time datetime={newest.date} data-f="rel">{faDate(newest.date, { day: 'numeric', month: 'long' })}</time></small>
            </a>
          </li>
        ))}
      </ol>
    </section>
  )
}
