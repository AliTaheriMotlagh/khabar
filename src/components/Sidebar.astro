---
// Wide screens only (hidden below 1080px, where the footer and tab bar carry these links).
import Icon from './Icon.astro';
import { SITE } from '../site';
import { getChannel, getTags, tagHref, faNum } from '../lib/posts';
interface Props { current?: string }
const { current } = Astro.props;
const channel = getChannel();
const tags = getTags().slice(0, 14);
---
<aside class="sidebar" aria-label="ستون کناری">
  <section class="side-card channel-card">
    <div class="ch-top">
      {channel.avatar ? <img src={channel.avatar} alt="" width="48" height="48" referrerpolicy="no-referrer" /> : <span class="logo-mark big" aria-hidden="true"></span>}
      <div>
        <b>{channel.title ?? SITE.nameLatin}</b>
        {channel.subscribers && <small><span data-num>{faNum(channel.subscribers)}</span> عضو</small>}
      </div>
    </div>
    <p>هر خبر اول در کانال تلگرام {SITE.owner.name} منتشر می‌شود؛ اینجا با ترجمه‌ی فارسی.</p>
    <a class="btn primary block" href={`https://t.me/${SITE.channel}`} target="_blank" rel="noopener" referrerpolicy="origin"><Icon name="telegram" /> عضویت در کانال</a>
  </section>

  {
    tags.length > 0 && (
      <section class="side-card">
        <h2 class="side-title">موضوع‌ها</h2>
        <div class="chips wrap">
          {tags.map((t) => (
            <a class="chip" href={tagHref(t.tag)} aria-current={current === t.tag ? 'page' : undefined}>
              {t.tag} <small data-num>{faNum(t.count)}</small>
            </a>
          ))}
        </div>
      </section>
    )
  }

  <section class="side-card" data-leaders hidden>
    <h2 class="side-title"><Icon name="trophy" /> فعال‌ترین‌های هفته</h2>
    <ol class="leaders" data-leaders-list></ol>
  </section>
</aside>
