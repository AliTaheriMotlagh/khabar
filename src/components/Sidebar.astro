---
// Wide screens only (hidden below 1080px, where the footer and tab bar carry these links). Short on purpose: the home
// page's own modules first (the slot: threads, the morning summary when a new video took its place), then the channel,
// the ways in and the topics.
import Icon from './Icon.astro';
import AdSlot from './AdSlot.astro';
import { SITE } from '../site';
import { getChannel, getTags, tagHref, faNum, pic, url } from '../lib/posts';
interface Props { current?: string }
const { current } = Astro.props;
const channel = getChannel();
const tags = getTags().slice(0, 10);
---
<aside class="sidebar" aria-label="ستون کناری">
  <slot />

  <section class="side-card channel-card">
    <div class="ch-top">
      {channel.avatar ? <img {...pic(channel.avatar, 'small')} alt="" width="40" height="40" loading="lazy" referrerpolicy="no-referrer" /> : <span class="logo-mark" aria-hidden="true"></span>}
      <div>
        <b>{channel.title ?? SITE.nameLatin}</b>
        {channel.subscribers && <small><span data-num>{faNum(channel.subscribers)}</span> عضو</small>}
      </div>
      <a class="btn sm primary" href={`https://t.me/${SITE.channel}`} target="_blank" rel="noopener" referrerpolicy="origin" aria-label="عضویت در کانال تلگرام"><Icon name="telegram" /> عضویت</a>
    </div>
  </section>

  <nav class="side-links" aria-label="کاوش">
    <a href={url('investigate/')}><Icon name="compass" /> کاوشگر خبر</a>
    <a href={url('archive/')}><Icon name="calendar" /> آرشیو روزها</a>
    <a href={url('week/')}><Icon name="trending" /> پربازدیدهای هفته</a>
  </nav>

  {
    tags.length > 0 && (
      <section class="side-card">
        <h2 class="side-title">موضوع‌ها</h2>
        <div class="chips wrap">
          {tags.map((t) => (
            <a class="chip" href={tagHref(t.tag)} aria-current={current === t.tag ? 'page' : undefined}>
              {t.tag} <small data-num>{faNum(t.count)}</small>
            </a>
          ))}
        </div>
      </section>
    )
  }

  <AdSlot slot="sidebar" />
</aside>
