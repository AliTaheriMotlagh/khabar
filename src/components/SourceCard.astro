---
// The original source of a story: the tweet (with all its media) or the linked article.
import Icon from './Icon.astro';
import Media from './Media.astro';
import { pic, type Link } from '../lib/posts';
interface Props { link: Link; alt: string; fallbackHref: string; showMedia?: boolean }
const { link, alt, fallbackHref, showMedia = true } = Astro.props;

// Split text into plain parts and clickable URLs (Astro escapes each part, so no HTML injection).
const URL_RE = /(https?:\/\/[^\s]+)/g;
const parts = (text = '') => text.split(URL_RE).map((v, i) => ({ v, url: i % 2 === 1 }));
const tweetDate = (t?: number) =>
  t ? new Intl.DateTimeFormat('fa-IR-u-ca-persian', { dateStyle: 'medium', timeZone: 'Asia/Tehran' }).format(new Date(t * 1000)) : '';
---
{
  link.kind === 'tweet' ? (
    <section class="source tweet" aria-label={`توییت ${link.author?.name ?? ''}`}>
      <div class="head">
        {link.author?.avatar ? <img {...pic(link.author.avatar, 'small')} alt="" width="40" height="40" loading="lazy" referrerpolicy="no-referrer" /> : <span class="av" />}
        <div class="who ltr" dir="ltr">
          <b>{link.author?.name}</b>
          <span>@{link.author?.handle}</span>
        </div>
        <Icon name="x-logo" class="logo" label="X" />
      </div>
      {link.text && <div class="txt" dir="auto">{parts(link.text).map((p) => (p.url ? <a href={p.v} rel="noopener nofollow" target="_blank">{p.v}</a> : p.v))}</div>}
      {link.article?.title && <p class="txt"><b dir="auto">{link.article.title}</b></p>}
      {showMedia && link.media && link.media.length > 0 && <Media items={link.media} alt={alt} fallbackHref={fallbackHref} limit={12} size="large" />}
      {link.quote && (
        <div class="quote">
          <div class="who ltr" dir="ltr"><b>{link.quote.author?.name}</b> <span>@{link.quote.author?.handle}</span></div>
          <div class="txt" dir="auto">{link.quote.text}</div>
          {showMedia && link.quote.media && link.quote.media.length > 0 && <Media items={link.quote.media} alt={alt} fallbackHref={fallbackHref} />}
        </div>
      )}
      <div class="foot">
        {link.date && <span>{tweetDate(link.date)}</span>}
        <a class="btn sm" href={link.url} target="_blank" rel="noopener">مشاهده در X <Icon name="external" /></a>
      </div>
    </section>
  ) : (
    <section class="source page" aria-label={`منبع: ${link.site ?? link.domain}`}>
      {link.image && (
        <a class="og" href={link.url} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
          <img {...pic(link.image, 'medium')} alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" data-fallback={link.url} />
          {link.kind === 'youtube' && <span class="play"><span><Icon name="play" /></span></span>}
        </a>
      )}
      <div class="body">
        <span class="site ltr" dir="ltr"><Icon name={link.kind === 'youtube' ? 'youtube' : 'link'} /> {link.site ?? link.domain}</span>
        <h3 dir="auto"><a href={link.url} target="_blank" rel="noopener">{link.title ?? link.url}</a></h3>
        {link.description && <p dir="auto">{link.description}</p>}
        <a class="btn sm" href={link.url} target="_blank" rel="noopener">{link.kind === 'youtube' ? 'دیدن در یوتیوب' : 'خواندن در سایت منبع'} <Icon name="external" /></a>
      </div>
    </section>
  )
}
