---
// The site's one player bar (src/scripts/listen.ts), in every page: a story read aloud (its steps are paragraphs), the
// morning brief, today's podcast or the week's most read (steps are stories). What plays is named on top and links to
// it. It stays while the reader moves to other pages (listen.ts, the shell). Media controls keep their left-to-right
// sense in this right-to-left site.
import Icon from './Icon.astro';
---
<div class="listen-bar" data-listen-bar role="region" aria-label="پخش صدا" hidden>
  <a class="lb-now" data-lb-now href="#"></a>
  <div class="lb-track" data-lb-track dir="ltr" aria-hidden="true"></div>
  <div class="lb-row">
    <span class="lb-pos" data-lb-pos aria-live="polite"></span>
    <div class="lb-ctl" dir="ltr">
      <button type="button" data-lb="prev" aria-label="قبلی" title="قبلی"><Icon name="skip-back" /></button>
      <button type="button" data-lb="back" aria-label="۱۰ ثانیه عقب" title="۱۰ ثانیه عقب"><Icon name="back10" /></button>
      <button type="button" class="lb-main" data-lb="toggle" aria-label="مکث"><Icon name="play" class="when-paused" /><Icon name="pause" class="when-playing" /></button>
      <button type="button" data-lb="fwd" aria-label="۱۰ ثانیه جلو" title="۱۰ ثانیه جلو"><Icon name="fwd10" /></button>
      <button type="button" data-lb="next" aria-label="بعدی" title="بعدی"><Icon name="skip-fwd" /></button>
    </div>
    <button class="lb-rate" type="button" data-lb="rate" aria-label="سرعت خواندن" title="سرعت خواندن">۱×</button>
    <button type="button" class="lb-x" data-lb="stop" aria-label="توقف و بستن" title="توقف"><Icon name="x" /></button>
  </div>
</div>
