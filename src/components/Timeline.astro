---
// The news as a timeline: days on a vertical rail, each post pinned at its time. A day's pill counts all of its news in
// `all` (the whole list this is a page of), not only what this page shows; digests are summaries, not news. `filter`
// (the home page): «همه / موضوع‌های من», shown once the reader follows a topic (src/scripts/follow.ts).
import Icon from './Icon.astro';
import StoryCard from './StoryCard.astro';
import { dayKey, faDate, faNum, type Post } from '../lib/posts';
import { url } from '../lib/posts';
interface Props { posts: Post[]; all?: Post[]; nextHref?: string | null; prevHref?: string | null; title?: string; eagerFirst?: boolean; topic?: string; filter?: boolean }
const { posts, all = posts, nextHref, prevHref, title = 'خط زمانی خبرها', eagerFirst = false, topic, filter = false } = Astro.props;
const perDay = new Map<string, number>();
for (const p of all) if (p.kind !== 'digest') perDay.set(dayKey(p.date), (perDay.get(dayKey(p.date)) ?? 0) + 1);

const days: { day: string; iso: string; posts: Post[] }[] = [];
for (const p of posts) {
  const d = dayKey(p.date);
  if (days.at(-1)?.day !== d) days.push({ day: d, iso: p.date, posts: [] });
  days.at(-1)!.posts.push(p);
}
---
<section class="timeline" aria-labelledby="tl-title">
  <h2 class="tl-title" id="tl-title">{title}</h2>
  {
    filter && (
      <div class="tl-filter" data-tl-filter hidden>
        <div class="seg" role="radiogroup" aria-label="کدام خبرها">
          <label><input type="radio" name="tl-filter" value="all" checked /><span>همه‌ی خبرها</span></label>
          <label><input type="radio" name="tl-filter" value="mine" /><span>موضوع‌های من</span></label>
        </div>
        <a class="tl-filter-edit" href={url('tags/')}>ویرایش موضوع‌ها</a>
      </div>
    )
  }
  <ol class="tl" data-tl>
    {
      days.map((d, di) => (
        <>
          <li class="tl-day" data-day={d.day}>
            <span class="tl-day-pill">
              <span data-day-label>{faDate(d.iso, { weekday: 'long', day: 'numeric', month: 'long' })}</span>
              {perDay.get(d.day) ? <small data-num>{faNum(perDay.get(d.day)!)} خبر</small> : null}
            </span>
          </li>
          {d.posts.map((p, i) => <StoryCard post={p} eager={eagerFirst && di === 0 && i < 2} topic={topic} />)}
        </>
      ))
    }
  </ol>
  {filter && <p class="tl-mine-empty" data-tl-mine-empty hidden>در این خبرها چیزی از موضوع‌های شما نیست؛ خبرهای قدیمی‌تر را ببینید یا موضوع‌های بیشتری دنبال کنید.</p>}
  {
    (nextHref || prevHref) && (
      <nav class="pager-nav" aria-label="صفحه‌بندی">
        {prevHref && <a class="btn" href={prevHref} rel="prev"><Icon name="arrow-r" /> جدیدتر</a>}
        {nextHref && <a class="btn primary" href={nextHref} rel="next" data-load-more>خبرهای قدیمی‌تر <Icon name="arrow" /></a>}
      </nav>
    )
  }
</section>
