---
// The news as a timeline: days on a vertical rail, each post pinned at its time.
import Icon from './Icon.astro';
import StoryCard from './StoryCard.astro';
import { dayKey, faDate, faNum, type Post } from '../lib/posts';
interface Props { posts: Post[]; nextHref?: string | null; prevHref?: string | null; title?: string; eagerFirst?: boolean }
const { posts, nextHref, prevHref, title = 'خط زمانی خبرها', eagerFirst = false } = Astro.props;

const days: { day: string; iso: string; posts: Post[] }[] = [];
for (const p of posts) {
  const d = dayKey(p.date);
  if (days.at(-1)?.day !== d) days.push({ day: d, iso: p.date, posts: [] });
  days.at(-1)!.posts.push(p);
}
---
<section class="timeline" aria-labelledby="tl-title">
  <div class="tl-bar">
    <h2 id="tl-title"><Icon name="clock" /> {title}</h2>
    <div class="seg-switch" role="group" aria-label="نمای خبرها">
      <button type="button" data-set-view="cards" aria-pressed="true"><Icon name="cards" /> کامل</button>
      <button type="button" data-set-view="list" aria-pressed="false"><Icon name="list" /> فهرست کوتاه</button>
    </div>
  </div>
  <ol class="tl" data-tl>
    {
      days.map((d, di) => (
        <>
          <li class="tl-day" data-day={d.day} data-day-count={d.posts.length}>
            <span class="tl-day-label" data-day-label>{faDate(d.iso, { weekday: 'long', day: 'numeric', month: 'long' })}</span>
            <small><span data-num>{faNum(d.posts.length)}</span> خبر</small>
          </li>
          {d.posts.map((p, i) => <StoryCard post={p} eager={eagerFirst && di === 0 && i < 2} />)}
        </>
      ))
    }
  </ol>
  {
    (nextHref || prevHref) && (
      <nav class="pager-nav" aria-label="صفحه‌بندی">
        {prevHref && <a class="btn" href={prevHref} rel="prev"><Icon name="arrow-r" /> جدیدتر</a>}
        {nextHref && <a class="btn primary" href={nextHref} rel="next" data-load-more>خبرهای قدیمی‌تر <Icon name="arrow" /></a>}
      </nav>
    )
  }
</section>
