---
// The news as a timeline: days on a vertical rail, each post pinned at its time. A day's pill counts all of its news in
// `all` (the whole list this is a page of), not only what this page shows; digests are summaries, not news. `filter`
// (the home page): «همه / موضوع‌های من», shown once the reader follows a topic, and a row of the stories' types
// («ابزار و محصول», «پژوهش و مقاله»…, from pipeline/ai.py) — src/scripts/follow.ts.
import Icon from './Icon.astro';
import StoryCard from './StoryCard.astro';
import { dayKey, faDate, faNum, STORY_TYPES, type Post } from '../lib/posts';
import { url } from '../lib/posts';
interface Props { posts: Post[]; all?: Post[]; nextHref?: string | null; prevHref?: string | null; title?: string; eagerFirst?: boolean; topic?: string; filter?: boolean }
const { posts, all = posts, nextHref, prevHref, title = 'خط زمانی خبرها', eagerFirst = false, topic, filter = false } = Astro.props;
const perDay = new Map<string, number>();
for (const p of all) if (p.kind !== 'digest') perDay.set(dayKey(p.date), (perDay.get(dayKey(p.date)) ?? 0) + 1);

// One filter bar (home page): the story's *type* (what kind of item: a tool, a paper… — pipeline/ai.py) and its
// *topic* (what it's about: a company, a field — the keyword tags), each a group of chips that combine.
const ICONS: Record<string, [string, string]> = {
  'ابزار و محصول': ['🛠', 'محصول، ابزار یا قابلیت تازه'],
  'پژوهش و مقاله': ['📄', 'مقاله، پژوهش یا نتیجه‌ی آزمایش'],
  آموزش: ['🎓', 'راهنما و آموزش'],
  'نظر و تحلیل': ['💭', 'دیدگاه، تحلیل یا گفت‌وگو'],
  'ویدیوی مهرزاد': ['▶', 'ویدیوهای یوتیوب مهرزاد صمدی'],
};
const TYPES = STORY_TYPES.filter((t) => t !== 'خبر').map((v) => ({ v, icon: ICONS[v]?.[0] ?? '•', hint: ICONS[v]?.[1] ?? v }));
// This page's most common topics (a story's first tag is its section).
const tagCount = new Map<string, number>();
for (const p of posts) for (const t of p.article.tags.slice(0, 2)) tagCount.set(t, (tagCount.get(t) ?? 0) + 1);
const topics = [...tagCount].filter(([, n]) => n >= 2).sort((a, b) => b[1] - a[1]).slice(0, 8).map(([t]) => t);

const days: { day: string; iso: string; posts: Post[] }[] = [];
for (const p of posts) {
  const d = dayKey(p.date);
  if (days.at(-1)?.day !== d) days.push({ day: d, iso: p.date, posts: [] });
  days.at(-1)!.posts.push(p);
}
---
<section class="timeline" aria-labelledby="tl-title">
  <h2 class="tl-title" id="tl-title">{title}</h2>
  {
    filter && (
      <div class="tl-bar" data-tl-bar>
        <div class="tl-chips" role="toolbar" aria-label="صافی خبرها">
          <label class="fchip fchip-all"><input type="radio" name="tl-type" value="" checked data-tl-all /><span>همه</span></label>
          <label class="fchip fchip-mine" data-tl-filter hidden><input type="checkbox" name="tl-filter" value="mine" /><span>★ موضوع‌های من</span></label>
          <span class="tl-group" data-tl-types role="radiogroup" aria-label="نوع خبر" hidden>
            <span class="tl-group-label" aria-hidden="true">نوع</span>
            {TYPES.map((t) => (
              <label class="fchip" data-type-chip={t.v} title={t.hint}><input type="radio" name="tl-type" value={t.v} /><span><i aria-hidden="true">{t.icon}</i>{t.v}</span></label>
            ))}
          </span>
          {
            topics.length > 1 && (
              <span class="tl-group" data-tl-topics role="radiogroup" aria-label="موضوع">
                <span class="tl-group-label" aria-hidden="true">موضوع</span>
                {topics.map((t) => (
                  <label class="fchip" data-topic-chip={t}><input type="radio" name="tl-topic" value={t} /><span>{t}</span></label>
                ))}
                <a class="fchip fchip-more" href={url('tags/')}>همه‌ی موضوع‌ها</a>
              </span>
            )
          }
        </div>
        <p class="tl-active" data-tl-active hidden>
          <span data-tl-active-text></span>
          <button type="button" class="tl-clear" data-tl-clear>پاک کردن صافی</button>
        </p>
      </div>
    )
  }
  <ol class="tl" data-tl>
    {
      days.map((d, di) => (
        <>
          <li class="tl-day" data-day={d.day}>
            <span class="tl-day-pill">
              <span data-day-label>{faDate(d.iso, { weekday: 'long', day: 'numeric', month: 'long' })}</span>
              {perDay.get(d.day) ? <small data-num>{faNum(perDay.get(d.day)!)} خبر</small> : null}
            </span>
          </li>
          {d.posts.map((p, i) => <StoryCard post={p} eager={eagerFirst && di === 0 && i < 2} topic={topic} />)}
        </>
      ))
    }
  </ol>
  {filter && <p class="tl-mine-empty" data-tl-mine-empty hidden>در این خبرها چیزی از موضوع‌های شما نیست؛ خبرهای قدیمی‌تر را ببینید یا موضوع‌های بیشتری دنبال کنید.</p>}
  {
    (nextHref || prevHref) && (
      <nav class="pager-nav" aria-label="صفحه‌بندی">
        {prevHref && <a class="btn" href={prevHref} rel="prev"><Icon name="arrow-r" /> جدیدتر</a>}
        {nextHref && <a class="btn primary" href={nextHref} rel="next" data-load-more>خبرهای قدیمی‌تر <Icon name="arrow" /></a>}
      </nav>
    )
  }
</section>
