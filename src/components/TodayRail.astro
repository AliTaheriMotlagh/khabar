---
// Stories on the home page, like Instagram's: one circle holding the recent stories, no topics. data-rail-ids lists
// them with their publish times. src/scripts/app.ts keeps what the reader's settings ask for (only the unseen ones by
// default, or today's, or all three days), counts what they haven't seen, puts the newest unseen story's picture on
// the circle (every story's picture is here, hidden, loaded only when shown) and hides the rail when nothing is left;
// the player (src/pages/today/) plays the same.
import Icon from './Icon.astro';
import { pic, storyItems, url } from '../lib/posts';
import { encodeStories } from '../lib/time';
const items = storyItems();
---
{
  items.length > 0 && (
    <nav class="rail" aria-label="استوری خبرهای تازه" data-rail>
      <a href={url('today/')} data-rail-ids={encodeStories(items)} aria-label="خبرهای تازه">
        <span class="ring">
          <span>
            {items.map(({ p }, k) => p.cover && <img {...pic(p.cover.src || p.cover.poster, 'small')} data-face={p.id} hidden={k > 0} alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" />)}
            <Icon name="news" />
          </span>
          <b class="rail-n" data-rail-n hidden></b>
        </span>
        <small>خبرهای تازه</small>
      </a>
    </nav>
  )
}
