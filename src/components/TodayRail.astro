---
// Stories on the home page: four circles, each playing a set in the player (src/pages/today/): "new" (arrived since
// the last visit), "unseen" (not opened or watched yet), "today" (the last 24 hours) and "all" (the last three days).
// src/scripts/app.ts counts the personal ones in the browser; a circle turns grey once everything in it was seen.
// data-recent lists the stories the player carries, newest first, today's marked with a "t".
import Icon from './Icon.astro';
import { faNum, recentPosts, todayPosts, url } from '../lib/posts';
const today = new Set(todayPosts().map((p) => p.id));
const recent = recentPosts();
const sets = [
  { set: 'new', icon: 'sparkles', label: 'تازه', count: null },
  { set: 'unseen', icon: 'eye', label: 'نخوانده', count: null },
  { set: 'today', icon: 'play', label: 'امروز', count: today.size },
  { set: 'all', icon: 'stories', label: 'همه', count: recent.length },
] as const;
---
{
  recent.length > 0 && (
    <nav class="rail" aria-label="استوری خبرها" data-rail data-recent={recent.map((p) => `${p.id}${today.has(p.id) ? 't' : ''}`).join(',')}>
      {sets.map((s) => (
        <a class={`story-${s.set}`} href={url(s.set === 'today' ? 'today/' : `today/?s=${s.set}`)} data-rail-set={s.set} aria-label={s.count != null ? `${s.label} · ${faNum(s.count)} خبر` : s.label}>
          <span class="ring"><span><Icon name={s.icon} /></span></span>
          <small>{s.label}<span data-rail-count>{s.count != null && ` · ${faNum(s.count)}`}</span></small>
        </a>
      ))}
    </nav>
  )
}
