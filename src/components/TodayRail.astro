---
// Stories on the home page, like Instagram's: one circle per topic (src/lib/time.ts, groupStories), every recent story
// in exactly one of them, each circle showing its newest story's picture. data-ids lists a circle's stories in the
// order they play (oldest first) with their publish times. src/scripts/app.ts keeps only the circles with something
// this reader hasn't seen (newest first, with how much) and hides the rail when nothing new is left; the player
// (src/pages/today/) plays only the unseen stories.
import Icon from './Icon.astro';
import { faNum, pic, storyGroups, url } from '../lib/posts';
import { encodeStories } from '../lib/time';
const groups = storyGroups();
---
{
  groups.length > 0 && (
    <nav class="rail" aria-label="استوری خبرها" data-rail>
      {groups.map((g, k) => {
        const face = [...g.items].reverse().find((i) => i.p.cover)?.p.cover;
        return (
          <a href={url(`today/?t=${encodeURIComponent(g.key)}`)} data-rail-group={g.key} data-ids={encodeStories(g.items)} aria-label={`${g.name} · ${faNum(g.items.length)} خبر`}>
            <span class="ring">
              <span>{face ? <img {...pic(face.src || face.poster, 'small')} alt="" loading={k < 6 ? undefined : 'lazy'} decoding="async" referrerpolicy="no-referrer" /> : <Icon name="news" />}</span>
              <b class="rail-n" data-rail-n hidden></b>
            </span>
            <small>{g.name}</small>
          </a>
        );
      })}
    </nav>
  )
}
