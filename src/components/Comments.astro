---
// Guest comments (no signup). Rendered and posted by src/scripts/social.ts.
interface Props { id: number }
const { id } = Astro.props;
---
<section class="comments" id="comments" data-comments={id} aria-labelledby="comments-title">
  <h2 class="section-title" id="comments-title">نظرها <span class="count" data-comments-count></span></h2>
  <form class="comment-form" data-comment-form>
    <textarea name="text" required minlength="2" maxlength="1000" rows="2" placeholder="نظرتان را بنویسید…" aria-label="متن نظر"></textarea>
    <input class="hp" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <div class="form-foot">
      <input name="name" maxlength="32" placeholder="نام (اختیاری)" aria-label="نام شما" autocomplete="nickname" />
      <button class="btn primary" type="submit">ارسال</button>
    </div>
  </form>
  <ol class="comment-list" data-comment-list aria-live="polite"></ol>
  <p class="muted" data-comments-empty hidden>هنوز نظری نیست.</p>
  <p class="muted" data-comments-off hidden>بخش نظرها فعلاً در دسترس نیست.</p>
</section>
