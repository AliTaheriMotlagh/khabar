---
// «ویدیوی تازه‌ی مهرزاد»: one compact strip above the home timeline for 48 hours after a new video of his (src/lib/videos.ts).
import Icon from './Icon.astro';
import { faDate, pic } from '../lib/posts';
import { clock, newVideo } from '../lib/videos';
const v = newVideo(2);
---
{
  v && (
    <a class="vd-strip" href={v.href}>
      <span class="vd-strip-thumb"><img {...pic(v.thumb, 'small')} alt="" width="320" height="180" loading="lazy" decoding="async" referrerpolicy="no-referrer" />{v.duration && <small>{clock(v.duration)}</small>}</span>
      <span class="vd-strip-text">
        <span class="vd-new"><Icon name="youtube" /> ویدیوی تازه‌ی مهرزاد{v.date && <> · {faDate(v.date, { day: 'numeric', month: 'long' })}</>}</span>
        <b dir="auto">{v.headline}</b>
      </span>
    </a>
  )
}
