---
import Icon from './Icon.astro';

type Choice = { v: string; l: string };
const groups: { key: string; label: string; choices: Choice[] }[] = [
  { key: 'theme', label: 'پوسته', choices: [{ v: 'auto', l: 'خودکار' }, { v: 'light', l: 'روشن' }, { v: 'dark', l: 'تیره' }] },
  { key: 'size', label: 'اندازه‌ی متن', choices: [{ v: 's', l: 'کوچک' }, { v: 'm', l: 'معمولی' }, { v: 'l', l: 'بزرگ' }, { v: 'xl', l: 'خیلی بزرگ' }] },
  { key: 'spacing', label: 'فاصله‌ی خطوط', choices: [{ v: 's', l: 'فشرده' }, { v: 'm', l: 'معمولی' }, { v: 'l', l: 'باز' }] },
  { key: 'focus', label: 'حالت مطالعه در صفحه‌ی خبر', choices: [{ v: 'off', l: 'عادی' }, { v: 'on', l: 'فقط خود خبر' }] },
  { key: 'view', label: 'نمای خبرها', choices: [{ v: 'cards', l: 'کامل با تصویر' }, { v: 'list', l: 'فهرست کوتاه' }] },
  { key: 'media', label: 'تصویر و ویدیو', choices: [{ v: 'show', l: 'نمایش' }, { v: 'tap', l: 'کم‌مصرف (با لمس)' }] },
];
---
<dialog class="sheet" id="settings" aria-labelledby="settings-title">
  <div class="sheet-head">
    <h2 id="settings-title">تنظیمات نمایش</h2>
    <button class="icon-btn" type="button" data-close aria-label="بستن"><Icon name="x" /></button>
  </div>
  <form class="sheet-body" data-settings-form>
    <p class="sample">ببین رفیق، اینجا متن رو همون‌طوری که راحتی تنظیم کن؛ اندازه، پوسته و نمای خبرها. ۱۴۰۵ — 2026</p>
    {
      groups.map((g) => (
        <fieldset class="opt">
          <legend>{g.label}</legend>
          <div class="seg">
            {g.choices.map((c) => (
              <label>
                <input type="radio" name={g.key} value={c.v} />
                <span>{c.l}</span>
              </label>
            ))}
          </div>
        </fieldset>
      ))
    }
    <div class="opt voice-row" data-voice-settings hidden>
      <span class="voice-row-text"><b>صدای فارسی برای «گوش دادن»</b><small data-voice-status></small></span>
      <button class="btn sm" type="button" data-voice-open>دانلود صدا</button>
    </div>
    <div class="sheet-foot">
      <button class="btn" type="button" data-reset>پیش‌فرض</button>
      <button class="btn primary" type="button" data-close>تمام</button>
    </div>
  </form>
</dialog>

<dialog class="lightbox" id="lightbox" aria-label="نمایش تصویر">
  <button class="icon-btn" type="button" data-close aria-label="بستن"><Icon name="x" /></button>
  <img alt="" referrerpolicy="no-referrer" data-lightbox-img />
</dialog>
