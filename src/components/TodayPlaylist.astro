---
// «پادکست امروز» on the home page: today's stories read one after another (src/scripts/playlist.ts) — each one's
// headline, then its text — with the screen locked too. A circle beside the stories one in the home's dateline. The
// stories of the last three days are here; the browser keeps today's (Tehran), or the last 24 hours after a quiet day,
// in the order the reader set for stories.
import Icon from './Icon.astro';
import { picture, storyItems } from '../lib/posts';
const items = storyItems().map(({ p, at }) => ({ id: p.id, t: p.article.title, at, h: p.href, m: p.minutes, c: p.cover ? picture(p.cover.src || p.cover.poster, 'small').src : '', ...(p.importance && { i: p.importance }) }));
---
{
  items.length > 0 && (
    <section class="pod" data-playlist={JSON.stringify(items)} aria-labelledby="playlist-title">
      <button class="pod-btn" type="button" data-playlist-play aria-describedby="playlist-meta">
        <span class="ring"><span><Icon name="headphones" class="when-idle" /><Icon name="pause" class="when-playing" /></span></span>
        <span class="sr-only" data-playlist-label>پخش</span>
        <small id="playlist-title">پادکست</small>
      </button>
      <small id="playlist-meta" class="sr-only" data-playlist-meta></small>
    </section>
  )
}
