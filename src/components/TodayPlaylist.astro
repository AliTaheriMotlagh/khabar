---
// «پادکست امروز» on the home page: today's stories read one after another (src/scripts/playlist.ts) — each one's
// headline, then its text — with the screen locked too. The stories of the last three days are here; the browser
// keeps today's (Tehran), or the last 24 hours after a quiet day, in the order the reader set for stories.
import Icon from './Icon.astro';
import { picture, storyItems } from '../lib/posts';
const items = storyItems().map(({ p, at }) => ({ id: p.id, t: p.article.title, at, h: p.href, m: p.minutes, c: p.cover ? picture(p.cover.src || p.cover.poster, 'small').src : '' }));
---
{
  items.length > 0 && (
    <>
      <section class="playlist" data-playlist={JSON.stringify(items)} hidden aria-labelledby="playlist-title">
        <button class="pl-play" type="button" data-playlist-play aria-describedby="playlist-meta">
          <Icon name="headphones" class="when-idle" />
          <Icon name="pause" class="when-playing" />
          <span class="sr-only" data-playlist-label>پخش</span>
        </button>
        <div class="pl-text">
          <b id="playlist-title">پادکست خبرهای امروز</b>
          <small id="playlist-meta" data-playlist-meta></small>
        </div>
      </section>
    </>
  )
}
