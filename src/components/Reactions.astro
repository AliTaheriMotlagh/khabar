---
// Guest reactions (no signup). Counts and the reader's own picks are filled in by src/scripts/social.ts.
import { REACTIONS } from '../lib/reactions';
interface Props { id: number }
const { id } = Astro.props;
---
<div class="reactions" data-reactions={id} role="group" aria-label="واکنش شما به این خبر">
  {REACTIONS.map((r) => (
    <button type="button" data-react={r.key} aria-pressed="false" title={r.label} aria-label={r.label}>
      <span class="emo">{r.emoji}</span>
      <b data-count={r.key}></b>
    </button>
  ))}
</div>
