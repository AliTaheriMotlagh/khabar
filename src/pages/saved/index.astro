---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
---
<Base title="ذخیره‌شده‌ها" noindex>
  <div class="container narrow">
    <header class="page-head"><h1>ذخیره‌شده‌ها</h1><p>خبرهایی که برای بعد نگه داشته‌اید — روی همین دستگاه، و حتی آفلاین.</p></header>
    <ul class="row-list" data-saved-list></ul>
    <div class="empty" data-saved-empty hidden>
      <Icon name="bookmark" />
      <p>هنوز چیزی ذخیره نکرده‌اید. روی نشانک کنار هر خبر بزنید.</p>
    </div>
  </div>
</Base>
<script>
  import { getSaved, rowHtml } from '../../scripts/app';
  const list = document.querySelector('[data-saved-list]')!;
  const empty = document.querySelector<HTMLElement>('[data-saved-empty]')!;
  function render() {
    const items = getSaved();
    empty.hidden = items.length > 0;
    list.innerHTML = items.map((s) => rowHtml(s, true)).join('');
  }
  render();
  document.addEventListener('saved-change', render);
</script>
