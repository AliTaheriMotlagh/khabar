---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { getPosts, getTags, sized, tagHref, faNum } from '../../lib/posts';
const posts = getPosts();
const topics = getTags().map((t) => {
  const items = posts.filter((p) => p.article.tags.includes(t.tag));
  return { ...t, latest: items[0], cover: items.find((p) => p.cover)?.cover };
});
---
<Base title="همه‌ی موضوع‌ها" description="موضوع‌های خبری: هوش مصنوعی، اوپن‌ای‌آی، آنتروپیک، گوگل، امنیت، رباتیک، تراشه، فضا، سلامت و …">
  <div class="container">
    <header class="page-head"><h1>موضوع‌ها</h1><p>هر موضوع، یک خط زمانی جدا.</p></header>
    <div class="topic-grid">
      {
        topics.map((t) => (
          <a class="topic" href={tagHref(t.tag)}>
            {t.cover ? <img src={sized(t.cover.src || t.cover.poster, 'small')} alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" /> : <span class="ph"><Icon name="hash" /></span>}
            <span class="topic-body">
              <b>{t.tag}</b>
              <small><span data-num>{faNum(t.count)}</span> خبر</small>
              {t.latest && <span class="topic-latest">{t.latest.article.title}</span>}
            </span>
          </a>
        ))
      }
    </div>
  </div>
</Base>
