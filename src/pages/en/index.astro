---
// The English edition's home: the dateline, the lead and the top stories, the channel's English 24-hour summary folded
// to one line, then the timeline; topics and the explorer in the wide screens' side column.
import Base from '../../layouts/Base.astro';
import EnTimeline from '../../components/EnTimeline.astro';
import AdSlot from '../../components/AdSlot.astro';
import Icon from '../../components/Icon.astro';
import Masthead from '../../components/Masthead.astro';
import { url } from '../../lib/posts';
import { frontEn } from '../../lib/front';
import { EN, EN_PAGE_SIZE, enDigest, enListLd, enTopicHref, enTopics, getEn } from '../../lib/en';

const all = getEn();
const first = all.slice(0, EN_PAGE_SIZE);
const front = frontEn(first);
const lead = front.leadPost;
const rest = first.filter((e) => e !== lead);
const next = all.length > EN_PAGE_SIZE ? url('en/page/2/') : null;
const digest = enDigest();
const items = digest?.items.slice(0, 6) ?? [];
const topics = enTopics().slice(0, 10);
---
<Base lang="en" alternates={{ fa: url() }} image={lead?.post.cover?.src} jsonLd={enListLd(`${EN.name} — ${EN.tagline}`, 'en/', first, true)} next={next}>
  <div class="container home">
    <Masthead lang="en" lead={front.lead} top={front.top} />
    <div class="layout home-layout">
      <div class="col-main">
        {
          digest && items.length > 0 && (
            <details class="brief" id="brief">
              <summary class="brief-sum">
                <span class="brief-icon" aria-hidden="true"><Icon name="bolt" /></span>
                <span class="brief-sum-text">
                  <b id="brief-title">The last 24 hours <small>· {digest.items.length} stories · <time datetime={digest.date} data-f="rel"></time></small></b>
                  <span class="brief-first">{items[0].text}</span>
                </span>
                <span class="chev" aria-hidden="true"></span>
              </summary>
              <div class="brief-body">
                <ol class="brief-list">
                  {items.map((i) => (
                    <li>{i.href ? <a href={i.href}>{i.text}</a> : <span>{i.text}</span>}</li>
                  ))}
                </ol>
              </div>
            </details>
          )
        }
        <EnTimeline items={rest} nextHref={next} ad />
      </div>
      <aside class="sidebar" aria-label="Topics">
        <section class="side-card">
          <h2 class="side-title">Topics</h2>
          <div class="chips wrap">{topics.map((t) => <a class="chip" href={enTopicHref(t.slug)}>{t.en} <small>{t.count}</small></a>)}</div>
        </section>
        <nav class="side-links" aria-label="Explore">
          <a href={url('en/investigate/')}><Icon name="compass" /> News explorer</a>
          <a href={url('en/archive/')}><Icon name="calendar" /> Archive by day</a>
          <a href={url('en/videos/')}><Icon name="youtube" /> Mehrzad's videos</a>
        </nav>
        <AdSlot slot="sidebar" />
      </aside>
    </div>
  </div>
</Base>
