---
// The news as a vertical video: one full-screen scene per story, playing on its own (src/scripts/player.ts).
// The page carries three days of stories; the browser plays one set of them (?s=new | unseen | all, default today,
// see chooseStories in src/lib/time.ts) and can switch sets in place. Which stories are today's is decided in the browser,
// with the reader's clock (data-date); the build's own count only feeds the description, structured data and the
// no-JS list. Without JS it's a plain list of the day's headlines.
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import SaveButton from '../../components/SaveButton.astro';
import { SITE } from '../../site';
import { abs, faNum, fresh, picture, recentPosts, sized, todayPosts, url, type Post } from '../../lib/posts';

const today = new Set(todayPosts().map((p) => p.id));
const posts = recentPosts();
const words = (s: string) => s.split(/\s+/).filter(Boolean).length;
/** What a scene reads aloud: the story's own text, never its headline (unless there is nothing else) — from the first
 *  paragraph that isn't just the headline again (a brief's first line is), up to about SAY_CHARS characters, skipping
 *  lines with links. `i` indexes the story's card.json (0 = the headline), which /api/tts reads. */
const SAY_CHARS = 350;
function sayOf(p: Post) {
  const head = p.article.title.replace(/…$/, '').trim();
  const out: { i: number; text: string }[] = [];
  let n = 0;
  p.article.body.forEach((raw, k) => {
    const text = raw.trim();
    if (!text || n >= SAY_CHARS || /https?:\/\//.test(text)) return;
    if (!k && text.length < head.length + 20 && text.startsWith(head.slice(0, 30))) return;
    out.push({ i: k + 1, text });
    n += text.length;
  });
  return out.length ? out : [{ i: 0, text: p.article.title }];
}
const scenes = posts.map((p) => {
  const video = p.gallery.find((m) => m.type === 'video' && m.src);
  const summary = p.excerpt && p.excerpt !== p.article.title ? p.excerpt : '';
  return {
    p,
    today: today.has(p.id),
    video: video ? { src: video.src!, poster: picture(video.poster, 'large').src, gif: !!video.gif, fresh: fresh(video.src) } : null,
    image: p.cover ? picture(p.cover.src || p.cover.poster, 'large') : { src: '', alt: undefined },
    og: p.cover ? sized(p.cover.src || p.cover.poster, 'large') : null, // social cards keep the original URL
    summary,
    // Seconds on screen without narration: enough to read the headline and summary at a brisk pace.
    seconds: Math.round(Math.min(16, Math.max(6, 2.5 + (words(p.article.title) + words(summary)) / 3.3))),
    say: sayOf(p),
    thumb: p.cover ? picture(p.cover.src || p.cover.poster, 'small') : null,
  };
});
const totalMin = Math.max(1, Math.round(scenes.filter((s) => s.today).reduce((n, s) => n + s.seconds, 0) / 60));
// The first scene's picture is what the page paints first: fetched right away, before the script runs.
const first = scenes[0] ? scenes[0].video?.poster || scenes[0].image.src : '';
const sets = [
  { set: 'new', icon: 'sparkles', label: 'تازه‌ها' },
  { set: 'unseen', icon: 'eye', label: 'نخوانده‌ها' },
  { set: 'today', icon: 'play', label: 'امروز' },
  { set: 'all', icon: 'stories', label: 'همه' },
] as const;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'امروز در یک نگاه',
    itemListOrder: 'https://schema.org/ItemListOrderDescending',
    numberOfItems: scenes.filter((s) => s.today).length,
    itemListElement: scenes.filter((s) => s.today).map((s, i) => ({ '@type': 'ListItem', position: i + 1, url: abs(`p/${s.p.id}/`), name: s.p.article.title })),
  },
];
---
<Base title="امروز در یک نگاه" description={`خبرهای امروز ${SITE.name}، پشت سر هم مثل یک ویدیو${today.size ? ` — حدود ${faNum(totalMin)} دقیقه` : ''}.`} image={scenes[0]?.og || null} jsonLd={jsonLd}>
  <Fragment slot="head">
    <link rel="preconnect" href="https://video.twimg.com" />
    {first && <link rel="preload" as="image" href={first} fetchpriority="high" />}
  </Fragment>
  <section class="player" data-player aria-label="خبرهای امروز در یک نگاه" aria-roledescription="نمایش خبرها" data-pagefind-ignore>
    <div class="pl-backdrop" data-pl-backdrop aria-hidden="true"></div>
    <div class="pl-frame">
      <div class="pl-stage" data-pl-stage>
        {
          scenes.map((s, i) => (
            <article class="pl-scene" data-i={i} data-id={s.p.id} data-gif={s.video?.gif ? '' : undefined} data-date={s.p.date} data-seconds={s.seconds} data-say={JSON.stringify(s.say)} aria-hidden={i ? 'true' : undefined}>
              <div class="pl-bg">
                {s.video ? (
                  <video data-src={s.video.src} poster={i < 2 ? s.video.poster || s.image.src || undefined : undefined} data-poster={s.video.poster || s.image.src} data-alt={s.video.fresh} muted playsinline loop preload="none" />
                ) : s.image.src ? (
                  i ? <img data-src={s.image.src} alt="" decoding="async" referrerpolicy="no-referrer" data-alt={s.image.alt} /> : <img src={s.image.src} alt="" fetchpriority="high" referrerpolicy="no-referrer" data-alt={s.image.alt} />
                ) : (
                  <span class="pl-noimg" aria-hidden="true"><Icon name="news" /></span>
                )}
              </div>
              <div class="pl-info">
                <div class="pl-meta">
                  <time datetime={s.p.date} data-f="rel"></time>
                  {s.p.source?.domain && <span class="pl-src" dir="ltr">{s.p.source.domain}</span>}
                </div>
                <h2 dir="auto">{s.p.article.title}</h2>
                {s.summary && <p dir="auto">{s.summary}</p>}
                <div class="pl-actions">
                  <a class="btn primary" href={s.p.href} data-pl-open>خواندن کامل <Icon name="arrow" /></a>
                  <SaveButton post={s.p} class="pl-btn" />
                  <button class="pl-btn" type="button" data-share data-url={s.p.href} data-title={s.p.article.title} aria-label="اشتراک‌گذاری"><Icon name="share" /></button>
                </div>
              </div>
            </article>
          ))
        }
        <div class="pl-end" data-pl-end hidden>
          <div class="pl-end-in">
            <div class="pl-end-head">
              <span class="pl-end-mark" aria-hidden="true"><Icon name="check" /></span>
              <h2 data-pl-end-title>همه‌ی خبرهای امروز را دیدید</h2>
              <p class="pl-end-stats" data-pl-end-text>
                <span><Icon name="stories" /> <b data-pl-total></b> خبر</span>
                <span><Icon name="clock" /> حدود <b data-pl-min></b> دقیقه</span>
              </p>
            </div>
            <section class="pl-recap" data-pl-recap aria-labelledby="pl-recap-h">
              <h3 id="pl-recap-h">مرور خبرها <small>برای دیدن دوباره بزنید</small></h3>
              <ol>
                {scenes.map((s) => (
                  <li data-pl-recap-id={s.p.id} hidden>
                    <button type="button" data-pl-go={s.p.id}>
                      {s.thumb?.src ? <img src={s.thumb.src} data-alt={s.thumb.alt} alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" /> : <span class="pl-recap-ph" aria-hidden="true"><Icon name="news" /></span>}
                      <span class="pl-recap-n" data-pl-recap-n></span>
                      <span class="pl-recap-t" dir="auto">{s.p.article.title}</span>
                    </button>
                  </li>
                ))}
              </ol>
            </section>
            <nav class="pl-sets" data-pl-sets aria-labelledby="pl-sets-h">
              <h3 id="pl-sets-h">ادامه بدهید</h3>
              {sets.map((x) => (
                <a href={url(x.set === 'today' ? 'today/' : `today/?s=${x.set}`)} data-pl-set={x.set}>
                  <span class="pl-set-ic"><Icon name={x.icon} /></span>
                  <span class="pl-set-t"><b>{x.label}</b><small data-pl-set-n></small></span>
                  <Icon name="arrow" />
                </a>
              ))}
            </nav>
            <div class="pl-end-actions">
              <button class="btn primary" type="button" data-pl-restart><Icon name="refresh" /> دوباره از اول</button>
              <a class="btn" href={url()}><Icon name="home" /> خانه</a>
            </div>
            <a class="pl-join" href={`https://t.me/${SITE.channel}`} target="_blank" rel="noopener" referrerpolicy="origin"><Icon name="telegram" /> خبرها را زودتر در کانال تلگرام ببینید</a>
          </div>
        </div>
      </div>

      <span class="pl-spin" aria-hidden="true"></span>
      <div class="pl-taps" data-pl-taps aria-hidden="true"></div>

      <div class="pl-top">
        <div class="pl-bars" data-pl-bars></div>
        <div class="pl-head">
          <span class="logo-mark" aria-hidden="true"></span>
          <span class="pl-title"><b data-pl-name>امروز در یک نگاه</b><small><span data-pl-pos>۱</span> از <span data-pl-count></span></small></span>
          <button class="pl-btn" type="button" data-pl-listen aria-pressed="false" aria-label="روایت خبر" title="روایت: خبر را برایتان می‌خواند (l)" hidden>
            <Icon name="headphones-off" class="when-off" /><Icon name="headphones" class="when-on" />
          </button>
          <button class="pl-btn" type="button" data-pl-sound aria-pressed="false" aria-label="صدای ویدیو" title="صدای ویدیو (m)" hidden>
            <Icon name="volume-off" class="when-off" /><Icon name="volume" class="when-on" />
          </button>
          <button class="pl-btn" type="button" data-pl-pause aria-pressed="false" aria-label="مکث" title="مکث (فاصله)">
            <Icon name="pause" class="when-off" /><Icon name="play" class="when-on" />
          </button>
          <a class="pl-btn" href={url()} data-pl-close aria-label="بستن" title="بستن (Esc)"><Icon name="x" /></a>
        </div>
      </div>

      <button class="pl-arrow prev" type="button" data-pl-prev aria-label="خبر قبلی"><Icon name="arrow-r" /></button>
      <button class="pl-arrow next" type="button" data-pl-next aria-label="خبر بعدی"><Icon name="arrow" /></button>
      <p class="pl-hint" data-pl-hint hidden>برای خبر بعدی سمت چپ را بزنید · نگه دارید تا مکث شود</p>
    </div>
  </section>
  <noscript>
    <div class="container narrow">
      <h1 class="page-head">امروز در یک نگاه</h1>
      <ol>{(today.size ? scenes.filter((s) => s.today) : scenes).map((s) => <li><a href={s.p.href}>{s.p.article.title}</a></li>)}</ol>
    </div>
  </noscript>
  <script>
    import '../../scripts/player';
  </script>
</Base>
