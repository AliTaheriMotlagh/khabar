---
import Base from '../../layouts/Base.astro';
import Timeline from '../../components/Timeline.astro';
import Sidebar from '../../components/Sidebar.astro';
import { SITE } from '../../site';
import { getPosts, url, faNum } from '../../lib/posts';

export function getStaticPaths() {
  const pages = Math.ceil(getPosts().length / SITE.pageSize);
  return Array.from({ length: Math.max(0, pages - 1) }, (_, i) => ({ params: { page: String(i + 2) } }));
}
const page = Number(Astro.params.page);
const posts = getPosts();
const total = Math.ceil(posts.length / SITE.pageSize);
const slice = posts.slice((page - 1) * SITE.pageSize, page * SITE.pageSize);
const prev = page === 2 ? url() : url(`page/${page - 1}/`);
const next = page < total ? url(`page/${page + 1}/`) : null;
---
<Base title={`آرشیو خبرها — صفحه‌ی ${faNum(page)}`} description={`${SITE.description} — صفحه‌ی ${faNum(page)} از ${faNum(total)}`}>
  <div class="container">
    <header class="page-head"><h1>آرشیو خبرها</h1><p>صفحه‌ی {faNum(page)} از {faNum(total)}</p></header>
    <div class="layout">
      <div class="col-main"><Timeline posts={slice} nextHref={next} prevHref={prev} title="خبرهای قدیمی‌تر" /></div>
      <Sidebar />
    </div>
  </div>
</Base>
