---
import Base from '../../layouts/Base.astro';
import Timeline from '../../components/Timeline.astro';
import Sidebar from '../../components/Sidebar.astro';
import { SITE } from '../../site';
import { getFeed, url, faNum } from '../../lib/posts';
import { listLd } from '../../lib/seo';

export function getStaticPaths() {
  const pages = Math.ceil(getFeed().length / SITE.pageSize);
  return Array.from({ length: Math.max(0, pages - 1) }, (_, i) => ({ params: { page: String(i + 2) } }));
}
const page = Number(Astro.params.page);
const posts = getFeed();
const total = Math.ceil(posts.length / SITE.pageSize);
const slice = posts.slice((page - 1) * SITE.pageSize, page * SITE.pageSize);
const prev = page === 2 ? url() : url(`page/${page - 1}/`);
const next = page < total ? url(`page/${page + 1}/`) : null;
const jsonLd = listLd({ name: `آرشیو خبرها — صفحه‌ی ${faNum(page)}`, path: `page/${page}/`, posts: slice });
---
<Base title={`آرشیو خبرها — صفحه‌ی ${faNum(page)}`} description={`آرشیو خبرهای هوش مصنوعی و فناوری ${SITE.name}، صفحه‌ی ${faNum(page)} از ${faNum(total)}: ${slice.slice(0, 3).map((p) => p.short).join('، ')} و …`} jsonLd={jsonLd} prev={prev} next={next}>
  <div class="container home">
    <header class="page-head"><h1>آرشیو خبرها</h1><p>صفحه‌ی {faNum(page)} از {faNum(total)}</p></header>
    <div class="layout home-layout">
      <div class="col-main"><Timeline posts={slice} all={posts} nextHref={next} prevHref={prev} title="خبرهای قدیمی‌تر" /></div>
      <Sidebar />
    </div>
  </div>
</Base>
