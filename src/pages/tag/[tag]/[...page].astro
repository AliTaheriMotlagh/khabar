---
import Base from '../../../layouts/Base.astro';
import Timeline from '../../../components/Timeline.astro';
import Sidebar from '../../../components/Sidebar.astro';
import Icon from '../../../components/Icon.astro';
import { SITE } from '../../../site';
import { getFeed, getTags, tagHref, faNum } from '../../../lib/posts';
import { listLd } from '../../../lib/seo';
import { tagFeed } from '../../../lib/feed';
import { topicIntro } from '../../../lib/knowledge';
import { enTopic } from '../../../lib/en';
import { url } from '../../../lib/posts';

// /tag/<tag>/ is the first page, /tag/<tag>/2/ … the older ones (a big topic holds hundreds of posts).
export function getStaticPaths() {
  const feed = getFeed();
  return getTags().flatMap(({ tag }) => {
    const posts = feed.filter((p) => p.article.tags.includes(tag));
    const total = Math.ceil(posts.length / SITE.pageSize);
    return Array.from({ length: total }, (_, i) => ({ params: { tag, page: i ? String(i + 1) : undefined }, props: { posts, page: i + 1, total } }));
  });
}
const { tag } = Astro.params;
const { posts, page, total } = Astro.props;
const slice = posts.slice((page - 1) * SITE.pageSize, page * SITE.pageSize);
const at = (n: number) => tagHref(tag!) + (n > 1 ? `${n}/` : '');
const prev = page > 1 ? at(page - 1) : null;
const next = page < total ? at(page + 1) : null;
const nth = page > 1 ? ` — صفحه‌ی ${faNum(page)}` : '';
// «این روزها در …» by the model, weekly (pipeline/topics.py): on the first page only.
const intro = page === 1 ? topicIntro(tag!) : null;
const jsonLd = listLd({ name: `اخبار ${tag}${nth}`, path: at(page), posts: slice, crumbs: [{ name: 'موضوع‌ها', path: 'tags/' }, { name: tag!, path: `tag/${encodeURIComponent(tag!)}/` }] });
---
<Base alternates={page === 1 && enTopic(tag!) ? { en: url(`en/topic/${enTopic(tag!)!.slug}/`) } : {}} title={`اخبار ${tag}${nth}`} description={`اخبار ${tag}${nth} به فارسی: ${slice.slice(0, 3).map((p) => p.short).join('، ')} و ${faNum(Math.max(0, posts.length - 3))} خبر دیگر، با تصویر و پیوند به منبع — ${SITE.name}`} image={slice.find((p) => p.cover)?.cover?.src} feed={tagFeed(tag!)} jsonLd={jsonLd} prev={prev} next={next}>
  <div class="container">
    <header class="page-head with-action">
      <div><h1>اخبار {tag}</h1><p><span data-num>{faNum(posts.length)}</span> خبر{page > 1 && ` · صفحه‌ی ${faNum(page)} از ${faNum(total)}`}</p></div>
      <button class="btn follow-btn" type="button" data-follow={tag} aria-pressed="false"><Icon name="plus" class="when-off" /><Icon name="check" class="when-on" /> <span data-follow-label>دنبال کردن</span></button>
    </header>
    {intro && <p class="topic-intro"><b>این روزها</b>{intro.intro}</p>}
    <div class="layout">
      <div class="col-main"><Timeline posts={slice} all={posts} nextHref={next} prevHref={prev} title={`خط زمانی ${tag}`} topic={tag} /></div>
      <Sidebar current={tag} />
    </div>
  </div>
</Base>
