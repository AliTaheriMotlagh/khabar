---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import Feed from '../../components/Feed.astro';
import { SITE } from '../../site';
import { getPosts, getTags, faNum } from '../../lib/posts';

export function getStaticPaths() {
  return getTags().map(({ tag }) => ({ params: { tag } }));
}
const { tag } = Astro.params;
const posts = getPosts().filter((p) => p.article.tags.includes(tag!));
---
<Base title={`اخبار ${tag}`} description={`تازه‌ترین اخبار ${tag} با خلاصه‌ی فارسی و جزئیات کامل منبع — ${SITE.name}`} image={posts[0]?.cover?.src}>
  <div class="wrap">
    <Hero current={tag} />
    <header class="page-head" style="padding-top:8px"><h1 style="font-size:1.3rem">اخبار {tag}</h1><p><span data-num>{faNum(posts.length)}</span> خبر</p></header>
    <Feed posts={posts} />
  </div>
</Base>
