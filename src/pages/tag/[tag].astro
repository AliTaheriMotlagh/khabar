---
import Base from '../../layouts/Base.astro';
import Timeline from '../../components/Timeline.astro';
import Sidebar from '../../components/Sidebar.astro';
import { SITE } from '../../site';
import { getFeed, getTags, faNum } from '../../lib/posts';

export function getStaticPaths() {
  return getTags().map(({ tag }) => ({ params: { tag } }));
}
const { tag } = Astro.params;
const posts = getFeed().filter((p) => p.article.tags.includes(tag!));
---
<Base title={`اخبار ${tag}`} description={`تازه‌ترین اخبار ${tag} با ترجمه‌ی فارسی، تصویر و ویدیو و پیوند به منبع اصلی — ${SITE.name}`} image={posts.find((p) => p.cover)?.cover?.src}>
  <div class="container">
    <header class="page-head"><h1>اخبار {tag}</h1><p><span data-num>{faNum(posts.length)}</span> خبر</p></header>
    <div class="layout">
      <div class="col-main"><Timeline posts={posts} title={`خط زمانی ${tag}`} /></div>
      <Sidebar current={tag} />
    </div>
  </div>
</Base>
