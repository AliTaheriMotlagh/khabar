---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Media from '../../components/Media.astro';
import SourceCard from '../../components/SourceCard.astro';
import SaveButton from '../../components/SaveButton.astro';
import { SITE } from '../../site';
import { getPosts, related, url, faDate, faNum, tagHref, type Post } from '../../lib/posts';

export function getStaticPaths() {
  const posts = getPosts();
  return posts.map((post, i) => ({
    params: { id: String(post.id) },
    props: { post, newer: posts[i - 1] ?? null, older: posts[i + 1] ?? null },
  }));
}
interface Props { post: Post; newer: Post | null; older: Post | null }
const { post, newer, older } = Astro.props;
const a = post.article;
const abs = (p: string) => new URL(url(p), Astro.site).href;
const description = (a.why ? `${post.excerpt} ${a.why}` : post.excerpt).slice(0, 300) || SITE.description;
const fromGholam = post.hasGholam;
const rel = related(post);
const shareUrl = new URL(post.href, Astro.site).href;
const enc = encodeURIComponent;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'NewsArticle',
    headline: a.title.slice(0, 110),
    description,
    inLanguage: 'fa-IR',
    datePublished: post.date,
    dateModified: post.date,
    mainEntityOfPage: shareUrl,
    image: post.cover ? [abs(post.cover.src)] : [abs('og.png')],
    keywords: a.tags.join(', '),
    articleSection: a.tags[0],
    author: [{ '@type': 'Person', name: fromGholam ? SITE.gholam : SITE.author, url: `https://t.me/${SITE.channel}` }],
    publisher: { '@type': 'Organization', name: SITE.name, logo: { '@type': 'ImageObject', url: abs('icon-512.png') } },
    isBasedOn: post.source?.url,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: SITE.name, item: abs('') },
      ...(a.tags[0] ? [{ '@type': 'ListItem', position: 2, name: a.tags[0], item: new URL(`tag/${enc(a.tags[0])}/`, abs('')).href }] : []),
      { '@type': 'ListItem', position: a.tags[0] ? 3 : 2, name: a.title.slice(0, 80) },
    ],
  },
];
---
<Base
  title={a.title}
  description={description}
  image={post.cover?.src}
  imageAlt={a.title}
  type="article"
  published={post.date}
  tags={a.tags}
  jsonLd={jsonLd}
  progress
>
  <article class="wrap article" data-article data-id={post.id} data-pagefind-body>
    <nav class="crumbs" aria-label="مسیر" data-pagefind-ignore>
      <a href={url()}>خانه</a> ‹
      {a.tags[0] && <><a href={tagHref(a.tags[0])}>{a.tags[0]}</a> ‹</>}
      <span>خبر <span data-num>{faNum(post.id)}</span></span>
    </nav>

    <h1 data-pagefind-meta="title">{a.title}</h1>
    {a.source_title && <p class="src-title ltr" dir="ltr">{a.source_title}</p>}

    <div class="meta" data-pagefind-ignore>
      <time datetime={post.date} data-f="long">{faDate(post.date, { dateStyle: 'full', timeStyle: 'short' })}</time>
      <span class="dot"></span>
      <span><Icon name="clock" /> <span data-num>{faNum(post.readingMinutes)}</span> دقیقه مطالعه</span>
      {post.views && <><span class="dot"></span><span><Icon name="eye" /> <span data-num>{faNum(post.views)}</span> بازدید</span></>}
      {post.edited && <><span class="dot"></span><span>ویرایش‌شده</span></>}
    </div>

    {post.heroMedia.length > 0 && <Media items={post.heroMedia} alt={a.title} eager fallbackHref={post.source?.url} />}
    {!post.heroMedia.length && post.cover && <Media items={[{ type: 'image', ...post.cover }]} alt={a.title} eager />}
    {post.cover && <meta data-pagefind-meta={`image:${url(post.cover.src)}`} />}

    {
      fromGholam ? (
        <div class="byline" data-pagefind-ignore>
          <span class="av" aria-hidden="true">غ</span>
          <span>به روایت <b>{SITE.gholam}</b></span>
        </div>
      ) : (
        <div class="byline" data-pagefind-ignore>
          <span class="av" aria-hidden="true"><Icon name="telegram" /></span>
          <span>متن پست کانال — خلاصه‌ی فارسی به‌زودی اضافه می‌شود</span>
        </div>
      )
    }
    <div class="prose" dir="auto">
      {a.body.map((p) => <p>{p}</p>)}
    </div>
    {a.why && <aside class="why"><b>چرا مهمه؟</b><p>{a.why}</p></aside>}

    {
      a.tags.length > 0 && (
        <div class="tags" data-pagefind-ignore>
          {a.tags.map((t) => <a class="chip" href={tagHref(t)} data-pagefind-filter="موضوع">{t}</a>)}
        </div>
      )
    }

    <div class="share" data-pagefind-ignore>
      <span class="label">اشتراک:</span>
      <SaveButton post={post} class="btn" label />
      <a class="btn" href={`https://t.me/share/url?url=${enc(shareUrl)}&text=${enc(a.title)}`} target="_blank" rel="noopener"><Icon name="telegram" /> تلگرام</a>
      <a class="btn" href={`https://x.com/intent/post?url=${enc(shareUrl)}&text=${enc(a.title)}`} target="_blank" rel="noopener"><Icon name="x-logo" /> ایکس</a>
      <a class="btn" href={`https://wa.me/?text=${enc(`${a.title}\n${shareUrl}`)}`} target="_blank" rel="noopener"><Icon name="whatsapp" /> واتساپ</a>
      <button class="btn" type="button" data-copy={post.href}><Icon name="link" /> کپی پیوند</button>
    </div>

    <div data-pagefind-ignore>
      {post.links && post.links.length > 0 && <h2 class="section-title">منبع اصلی خبر</h2>}
      {post.links?.map((l) => <SourceCard link={l} alt={a.title} />)}
      {
        !post.links?.length && post.preview?.title && (
          <section class="source">
            <div class="body">
              <div class="site">{post.preview.site}</div>
              <h3 dir="auto"><a href={post.preview.url} target="_blank" rel="noopener">{post.preview.title}</a></h3>
              {post.preview.description && <p class="desc" dir="auto">{post.preview.description}</p>}
            </div>
          </section>
        )
      }

      <h2 class="section-title">پست در کانال تلگرام</h2>
      <section class="source">
        {post.text && <div class="txt" dir="auto">{post.text}</div>}
        <div class="stats">
          {post.forwarded_from && <span>بازارسال از {post.forwarded_from}</span>}
          <a href={post.url} target="_blank" rel="noopener">مشاهده در تلگرام ↗</a>
        </div>
      </section>

      <nav class="pager" aria-label="خبر قبلی و بعدی">
        {newer && <a href={newer.href} data-prev rel="prev"><small>خبر جدیدتر (p)</small>{newer.article.title}</a>}
        {older && <a class="next" href={older.href} data-next rel="next"><small>خبر قدیمی‌تر (n)</small>{older.article.title}</a>}
      </nav>

      {
        rel.length > 0 && (
          <section class="related-wrap">
            <h2 class="section-title">خبرهای مرتبط</h2>
            <div class="related">
              {rel.map((r) => (
                <a href={r.href}>
                  {r.cover && <img src={url(r.cover.src)} alt="" width="76" height="56" loading="lazy" decoding="async" />}
                  <span>{r.article.title}</span>
                </a>
              ))}
            </div>
          </section>
        )
      }
    </div>
  </article>
</Base>
