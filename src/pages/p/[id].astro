---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Media from '../../components/Media.astro';
import SourceCard from '../../components/SourceCard.astro';
import SourceChip from '../../components/SourceChip.astro';
import SaveButton from '../../components/SaveButton.astro';
import Reactions from '../../components/Reactions.astro';
import Comments from '../../components/Comments.astro';
import { SITE } from '../../site';
import { abs, getFeed, getPosts, related, sized, faDate, faNum, tagHref, type Post } from '../../lib/posts';

export function getStaticPaths() {
  // Previous/next walk the listed feed; an unlisted (English-only) page has none.
  const feed = getFeed();
  return getPosts().map((post) => {
    const i = feed.indexOf(post);
    return { params: { id: String(post.id) }, props: { post, newer: i > 0 ? feed[i - 1] : null, older: i >= 0 ? feed[i + 1] ?? null : null } };
  });
}
interface Props { post: Post; newer: Post | null; older: Post | null }
const { post, newer, older } = Astro.props;
const a = post.article;
const description = [post.excerpt || a.title, a.why].filter(Boolean).join(' ').slice(0, 300) || SITE.description;
const coverSrc = post.cover ? sized(post.cover.src || post.cover.poster, 'large') : null;
const shareUrl = abs(`p/${post.id}/`);
const enc = encodeURIComponent;
const ownMedia = (post.media ?? []).length > 0;
const rel = related(post);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'NewsArticle',
    headline: a.title.slice(0, 110),
    description,
    inLanguage: 'fa-IR',
    datePublished: post.date,
    dateModified: post.updated || post.date,
    mainEntityOfPage: { '@type': 'WebPage', '@id': shareUrl },
    url: shareUrl,
    image: coverSrc ? [coverSrc] : [abs('og.png')],
    keywords: a.tags.join(', '),
    articleSection: a.tags[0],
    author: { '@type': 'Person', name: SITE.owner.nameLatin, alternateName: SITE.owner.name, url: SITE.owner.url },
    publisher: { '@id': `${SITE.url}/#org` },
    isBasedOn: post.source?.url ?? post.url,
    sameAs: post.url,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: SITE.name, item: abs('') },
      ...(a.tags[0] ? [{ '@type': 'ListItem', position: 2, name: a.tags[0], item: abs(`tag/${enc(a.tags[0])}/`) }] : []),
      { '@type': 'ListItem', position: a.tags[0] ? 3 : 2, name: a.title.slice(0, 80), item: shareUrl },
    ],
  },
];
---
<Base
  title={a.title}
  description={description}
  image={coverSrc}
  imageAlt={a.title}
  type="article"
  published={post.date}
  modified={post.updated || post.date}
  section={a.tags[0]}
  tags={a.tags}
  jsonLd={jsonLd}
  noindex={!post.listed}
  progress
>
  <div class="container narrow">
    <article class="article" data-article data-id={post.id} data-title={a.title} data-href={post.href} data-cover={post.cover ? sized(post.cover.src || post.cover.poster, 'small') : ''} data-tags={a.tags.join(',')} data-minutes={post.minutes} data-pagefind-body>
      <header class="article-head">
        <div class="story-head" data-pagefind-ignore>
          {post.kind === 'digest' ? <span class="kicker"><Icon name="bolt" /> خلاصه‌ی صبح</span> : a.tags[0] && <a class="kicker" href={tagHref(a.tags[0])}>{a.tags[0]}</a>}
          <SourceChip link={post.source} />
        </div>
        <h1 data-pagefind-meta="title">{a.title}</h1>
        <div class="article-meta" data-pagefind-ignore>
          <span>{post.kind === 'story' ? SITE.gholam : `@${SITE.channel}`}</span>
          <time datetime={post.date} data-f="rel" title={faDate(post.date, { dateStyle: 'full', timeStyle: 'short' })}>{faDate(post.date, { day: 'numeric', month: 'long' })}</time>
          <span><span data-num>{faNum(post.minutes)}</span> دقیقه</span>
          <span data-views={post.id} hidden><span></span> بازدید</span>
        </div>
      </header>

      <div class="reader-bar" role="toolbar" aria-label="ابزار مطالعه" data-pagefind-ignore>
        <button class="rb-btn listen" type="button" data-listen aria-pressed="false" hidden>
          <Icon name="volume" class="when-idle" /><Icon name="pause" class="when-playing" /><span data-listen-label>گوش دادن</span>
        </button>
        <button class="rb-btn rate" type="button" data-rate aria-label="سرعت خواندن" title="سرعت خواندن">۱×</button>
        <button class="rb-btn" type="button" data-open-settings aria-label="اندازه‌ی متن و نمایش" title="اندازه‌ی متن (+ / -)"><span class="aa" aria-hidden="true">Aa</span></button>
        <button class="rb-btn if-focus" type="button" data-theme-toggle aria-label="روشن / تیره" title="روشن / تیره (t)"><Icon name="moon" class="if-light" /><Icon name="sun" class="if-dark" /></button>
        <button class="rb-btn focus-btn" type="button" data-focus-toggle aria-pressed="false" aria-label="حالت مطالعه" title="حالت مطالعه (f)">
          <Icon name="book" class="when-off" /><Icon name="x" class="when-on" /><span class="when-off">مطالعه</span><span class="when-on lbl-wide">خروج</span>
        </button>
        <span class="time-left" data-time-left></span>
      </div>

      {post.gallery.length > 0 && <div class="article-media"><Media items={post.gallery} alt={a.title} fallbackHref={post.url} limit={12} size="large" eager /></div>}
      {!post.gallery.length && coverSrc && (
        <div class="article-media"><Media items={[{ type: 'image', src: coverSrc }]} alt={a.title} fallbackHref={post.url} size="large" eager /></div>
      )}
      {coverSrc && <meta data-pagefind-meta={`image:${coverSrc}`} />}

      {
        post.kind === 'digest' ? (
          <ol class="digest-list big">
            {post.digestItems.map((i) => (
              <li>
                <span class="n" data-num>{faNum(i.n)}</span>
                <a href={i.href} target={i.internal ? undefined : '_blank'} rel={i.internal ? undefined : 'noopener'}>{i.text}</a>
              </li>
            ))}
          </ol>
        ) : (
          <div class="prose" dir="auto">{a.body.map((p) => <p>{p}</p>)}</div>
        )
      }
      {a.why && <aside class="why"><b>چرا مهمه؟</b><p>{a.why}</p></aside>}

      <div class="engage" data-pagefind-ignore>
        <Reactions id={post.id} />
        <div class="share-bar">
          <SaveButton post={post} />
          <button class="icon-btn" type="button" data-share data-url={post.href} data-title={a.title} aria-label="اشتراک‌گذاری"><Icon name="share" /></button>
          <a class="icon-btn" href={post.url} target="_blank" rel="noopener" referrerpolicy="origin" aria-label="دیدن در کانال تلگرام" title="دیدن در کانال تلگرام"><Icon name="telegram" /></a>
        </div>
      </div>

      <div class="article-tail" data-pagefind-ignore>
        {post.links && post.links.length > 0 && <h2 class="section-title">منبع</h2>}
        {post.links?.map((l) => <SourceCard link={l} alt={a.title} fallbackHref={post.url} showMedia={ownMedia} />)}
        {
          !post.links?.length && post.preview?.title && (
            <section class="source page">
              <div class="body">
                <span class="site">{post.preview.site}</span>
                <h3 dir="auto"><a href={post.preview.url} target="_blank" rel="noopener">{post.preview.title}</a></h3>
                {post.preview.description && <p dir="auto">{post.preview.description}</p>}
              </div>
            </section>
          )
        }

        <Comments id={post.id} />

        {
          rel.length > 0 && (
            <section>
              <h2 class="section-title">بیشتر بخوانید</h2>
              <div class="related">
                {rel.map((r) => (
                  <a class="rel-card" href={r.href}>
                    {r.cover ? <img src={sized(r.cover.src || r.cover.poster, 'small')} alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" /> : <span class="ph"><Icon name="news" /></span>}
                    <span>{r.article.title}</span>
                  </a>
                ))}
              </div>
            </section>
          )
        }

        <nav class="pager" aria-label="خبر قبلی و بعدی">
          {newer && <a href={newer.href} data-prev rel="prev"><small><Icon name="arrow-r" /> جدیدتر</small>{newer.article.title}</a>}
          {older && <a class="next" href={older.href} data-next rel="next"><small>قدیمی‌تر <Icon name="arrow" /></small>{older.article.title}</a>}
        </nav>
      </div>
    </article>
  </div>
  <div class="resume" data-resume hidden>
    <button class="btn primary sm" type="button" data-resume-go><Icon name="book" /> ادامه از جایی که ماندید</button>
    <button class="icon-btn" type="button" data-resume-x aria-label="بستن"><Icon name="x" /></button>
  </div>
  <button class="quote-btn" type="button" data-quote hidden><Icon name="share" /> اشتراک این بخش</button>
</Base>
