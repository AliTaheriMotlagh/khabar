---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Media from '../../components/Media.astro';
import SourceCard from '../../components/SourceCard.astro';
import SourceChip from '../../components/SourceChip.astro';
import { cleanUrl, publisherOf } from '../../lib/source';
import SaveButton from '../../components/SaveButton.astro';
import Reactions from '../../components/Reactions.astro';
import Comments from '../../components/Comments.astro';
import { SITE } from '../../site';
import { abs, getFeed, getPosts, related, sized, faDate, faNum, pic, picture, tagHref, url, whyLabel, type Post } from '../../lib/posts';
import Quiz from '../../components/Quiz.astro';
import ThreadBox from '../../components/ThreadBox.astro';
import StoryFacts from '../../components/StoryFacts.astro';
import StatusChip from '../../components/StatusChip.astro';
import AdSlot from '../../components/AdSlot.astro';
import { enOf } from '../../lib/en';

export function getStaticPaths() {
  // Previous/next walk the listed feed; an unlisted (English-only) page has none.
  const feed = getFeed();
  return getPosts().map((post) => {
    const i = feed.indexOf(post);
    return { params: { id: String(post.id) }, props: { post, newer: i > 0 ? feed[i - 1] : null, older: i >= 0 ? feed[i + 1] ?? null : null } };
  });
}
interface Props { post: Post; newer: Post | null; older: Post | null }
const { post, newer, older } = Astro.props;
const a = post.article;
const description = [post.excerpt || a.title, a.why].filter(Boolean).join(' ').slice(0, 300) || SITE.description;
const coverSrc = post.cover ? sized(post.cover.src || post.cover.poster, 'large') : null;
const shareUrl = abs(`p/${post.id}/`);
const enc = encodeURIComponent;
const ownMedia = (post.media ?? []).length > 0;
const rel = related(post);
// The same news told in other posts (data/related.json clusters): listed under the story as its updates.
const byId = new Map(getPosts().map((p) => [p.id, p]));
const updates = post.cluster.map((id) => byId.get(id)).filter((p): p is Post => !!p && p.listed);
const count = (t: string) => t.split(/\s+/).filter(Boolean).length;
// A story whose translation came through empty (a bare link) is its headline: never a word count of 0.
const words = count([...a.body, a.why ?? ''].join(' ')) || count(a.title);
// The people, companies and models the story names (pipeline/ai.py, `ai.x.entities`): linked data for search engines.
const mentions = (post.entities ?? []).map((e) => ({ '@type': e.kind === 'person' ? 'Person' : e.kind === 'company' ? 'Organization' : 'Thing', name: e.name_en, alternateName: e.name_fa, url: abs(`who/${e.slug}/`) }));
// X's video addresses are stable (Telegram's are signed and expire), so only those are offered to search as a video.
const video = post.gallery.find((m) => m.type === 'video' && !m.gif && m.src && /^https:\/\/video\.twimg\.com\//.test(m.src));
const isoDuration = (d: unknown) => {
  const n = typeof d === 'number' ? d : typeof d === 'string' && /^\d+:\d{2}$/.test(d) ? d.split(':').reduce((t, x) => t * 60 + Number(x), 0) : 0;
  return n > 0 ? `PT${Math.round(n)}S` : undefined;
};

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'NewsArticle',
    headline: a.title.slice(0, 110),
    description,
    inLanguage: 'fa-IR',
    datePublished: post.date,
    dateModified: post.updated || post.date,
    mainEntityOfPage: { '@type': 'WebPage', '@id': shareUrl },
    url: shareUrl,
    image: coverSrc ? [coverSrc] : [abs('og.png')],
    thumbnailUrl: coverSrc || abs('og.png'),
    keywords: a.tags.join(', '),
    articleSection: a.tags[0],
    wordCount: words,
    isAccessibleForFree: true,
    // The parts a voice assistant should read (Google's speakable): the headline and the first paragraph.
    speakable: { '@type': 'SpeakableSpecification', cssSelector: ['.article-head h1', '.prose > p:first-child'] },
    ...(post.type && { genre: post.type }),
    ...(mentions.length && { mentions }),
    author: { '@type': 'Person', name: SITE.owner.nameLatin, alternateName: SITE.owner.name, url: SITE.owner.url },
    publisher: { '@id': `${SITE.url}/#org` },
    isBasedOn: post.source?.url ?? post.url,
    sameAs: post.url,
    ...(video && {
      video: {
        '@type': 'VideoObject',
        name: a.title.slice(0, 110),
        description,
        thumbnailUrl: [sized(video.poster, 'large') || coverSrc || abs('og.png')],
        uploadDate: post.date,
        contentUrl: video.src,
        duration: isoDuration(video.duration),
        inLanguage: 'fa-IR',
      },
    }),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: SITE.name, item: abs('') },
      ...(a.tags[0] ? [{ '@type': 'ListItem', position: 2, name: a.tags[0], item: abs(`tag/${enc(a.tags[0])}/`) }] : []),
      { '@type': 'ListItem', position: a.tags[0] ? 3 : 2, name: a.title.slice(0, 80), item: shareUrl },
    ],
  },
];
---
<Base
  title={a.title}
  description={description}
  image={coverSrc}
  imageAlt={a.title}
  type="article"
  published={post.date}
  modified={post.updated || post.date}
  section={a.tags[0]}
  tags={a.tags}
  jsonLd={jsonLd}
  noindex={!post.listed}
  progress
  alternates={{ en: enOf(post.id)?.href }}
>
  <div class="container narrow">
    <article class="article" data-article data-id={post.id} data-title={a.title} data-href={post.href} data-cover={post.cover ? picture(post.cover.src || post.cover.poster, 'small').src : ''} data-tags={a.tags.join(',')} data-minutes={post.minutes} data-pagefind-body>
      <header class="article-head">
        <div class="story-head" data-pagefind-ignore>
          {post.kind === 'digest' ? <span class="kicker"><Icon name="bolt" /> خلاصه‌ی صبح</span> : a.tags[0] && <a class="kicker" href={tagHref(a.tags[0])}>{a.tags[0]}</a>}
          <SourceChip link={post.source} />
        </div>
        <h1 data-pagefind-meta="title">{a.title}</h1>
        <div class="article-meta" data-pagefind-ignore>
          <span>{post.kind === 'story' ? SITE.gholam : `@${SITE.channel}`}</span>
          <time datetime={post.date} data-f="rel" title={faDate(post.date, { dateStyle: 'full', timeStyle: 'short' })}>{faDate(post.date, { day: 'numeric', month: 'long' })}</time>
          <span><span data-num>{faNum(post.minutes)}</span> دقیقه</span>
          <StatusChip status={post.status} />
          {post.importance && post.importance >= 4 && <span class="must">حتماً بخوانید</span>}
          {post.translated && <span class="auto-tr" title="غلام برای این پست ترجمه‌ای ننوشت؛ این متن را مدل هوش مصنوعی سایت از منبع ترجمه کرده.">ترجمه‌ی خودکار</span>}
          <a class="views-link" href={url('stats/')} data-views={post.id} hidden title="آمار بازدید"><span></span> بازدید<small data-views-day hidden></small></a>
        </div>
      </header>

      <div class="reader-bar" role="toolbar" aria-label="ابزار مطالعه" data-pagefind-ignore>
        <button class="rb-btn listen" type="button" data-listen aria-pressed="false" hidden>
          <Icon name="volume" class="when-idle" /><Icon name="pause" class="when-playing" /><span data-listen-label>گوش دادن</span>
        </button>
        <button class="rb-btn" type="button" data-make-video={post.href} title="ویدیوی این خبر را روی همین دستگاه بسازید" hidden><Icon name="film" /><span>ویدیو</span></button>
        <button class="rb-btn" type="button" data-open-settings aria-label="اندازه‌ی متن و نمایش" title="اندازه‌ی متن (+ / -)"><span class="aa" aria-hidden="true">Aa</span></button>
        <button class="rb-btn if-focus" type="button" data-theme-toggle aria-label="روشن / تیره" title="روشن / تیره (t)"><Icon name="moon" class="if-light" /><Icon name="sun" class="if-dark" /></button>
        <button class="rb-btn focus-btn" type="button" data-focus-toggle aria-pressed="false" aria-label="حالت مطالعه" title="حالت مطالعه (f)">
          <Icon name="book" class="when-off" /><Icon name="x" class="when-on" /><span class="when-off">مطالعه</span><span class="when-on lbl-wide">خروج</span>
        </button>
        <span class="time-left" data-time-left></span>
      </div>

      {post.gallery.length > 0 && <div class="article-media"><Media items={post.gallery} alt={a.title} fallbackHref={post.url} limit={12} size="large" eager /></div>}
      {!post.gallery.length && coverSrc && (
        <div class="article-media"><Media items={[{ type: 'image', src: coverSrc }]} alt={a.title} fallbackHref={post.url} size="large" eager /></div>
      )}
      {coverSrc && <meta data-pagefind-meta={`image:${coverSrc}`} />}

      {
        post.kind === 'digest' ? (
          <ol class="digest-list big">
            {post.digestItems.map((i) => (
              <li>
                <span class="n" data-num>{faNum(i.n)}</span>
                <a href={i.href} target={i.internal ? undefined : '_blank'} rel={i.internal ? undefined : 'noopener'}>{i.text}</a>
              </li>
            ))}
          </ol>
        ) : (
          <div class="prose" dir="auto">{a.body.map((p) => <p>{p}</p>)}</div>
        )
      }
      {a.why && <aside class={post.whyByModel ? 'why by-model' : 'why'}><b>{whyLabel(a)}{post.whyByModel && <small title="غلام برای این خبر «چرا مهمه؟» ننوشت؛ این یک جمله را مدل هوش مصنوعی سایت نوشته."> · به قلم هوش مصنوعی</small>}</b><p>{a.why}</p></aside>}
      {
        post.simple && (
          <details class="simple" data-simple data-pagefind-ignore>
            <summary>به زبان ساده</summary>
            <p>{post.simple}</p>
          </details>
        )
      }
      <StoryFacts post={post} />
      {
        post.entities.length > 0 && (
          <nav class="who-chips" aria-label="آدم‌ها و شرکت‌های این خبر" data-pagefind-ignore>
            {post.entities.map((e) => <a href={url(`who/${e.slug}/`)}>{e.name_fa}</a>)}
          </nav>
        )
      }
      {
        updates.length > 0 && (
          <section class="updates" id="updates" data-pagefind-ignore>
            <h2 class="section-title">همین خبر در پست‌های دیگر</h2>
            <ul>{updates.map((u) => <li><a href={u.href}>{u.article.title}</a> <time datetime={u.date} data-f="rel">{faDate(u.date, { day: 'numeric', month: 'long' })}</time></li>)}</ul>
          </section>
        )
      }
      {post.thread && <ThreadBox post={post} />}

      <div class="engage" data-pagefind-ignore>
        <Reactions id={post.id} />
        <div class="share-bar">
          <SaveButton post={post} />
          <button class="icon-btn" type="button" data-share data-url={post.href} data-title={a.title} aria-label="اشتراک‌گذاری"><Icon name="share" /></button>
          <a class="icon-btn" href={post.url} target="_blank" rel="noopener" referrerpolicy="origin" aria-label="دیدن در کانال تلگرام" title="دیدن در کانال تلگرام"><Icon name="telegram" /></a>
        </div>
      </div>

      <AdSlot slot="story" />

      <div class="article-tail" data-pagefind-ignore>
        {post.links && post.links.length > 0 && <h2 class="section-title">منبع</h2>}
        {post.links?.map((l) => <SourceCard link={l} alt={a.title} fallbackHref={post.url} showMedia={ownMedia} />)}
        {
          !post.links?.length && post.preview?.title && (
            <section class="source page">
              <div class="body">
                <span class="site"><Icon name="link" /> <b dir="auto">{publisherOf(post.preview.url) || post.preview.site}</b></span>
                <h3 dir="auto"><a href={cleanUrl(post.preview.url ?? post.url)} target="_blank" rel="noopener">{post.preview.title}</a></h3>
                {post.preview.description && <p dir="auto">{post.preview.description}</p>}
              </div>
            </section>
          )
        }

        {post.quiz && <Quiz id={post.id} quiz={post.quiz} />}

        <Comments id={post.id} />

        {
          rel.length > 0 && (
            <section>
              <h2 class="section-title">بیشتر بخوانید</h2>
              <div class="related">
                {rel.map((r) => (
                  <a class="rel-card" href={r.href}>
                    {r.cover ? <img {...pic(r.cover.src || r.cover.poster, 'small')} alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" /> : <span class="ph"><Icon name="news" /></span>}
                    <span>{r.article.title}</span>
                  </a>
                ))}
              </div>
            </section>
          )
        }

        <nav class="pager" aria-label="خبر قبلی و بعدی">
          {newer && <a href={newer.href} data-prev rel="prev"><small><Icon name="arrow-r" /> جدیدتر</small>{newer.article.title}</a>}
          {older && <a class="next" href={older.href} data-next rel="next"><small>قدیمی‌تر <Icon name="arrow" /></small>{older.article.title}</a>}
        </nav>
      </div>
    </article>
  </div>
  <div class="resume" data-resume hidden>
    <button class="btn primary sm" type="button" data-resume-go><Icon name="book" /> ادامه از جایی که ماندید</button>
    <button class="icon-btn" type="button" data-resume-x aria-label="بستن"><Icon name="x" /></button>
  </div>
  <div class="quote-bar" data-quote-bar role="toolbar" aria-label="بخش انتخاب‌شده" hidden>
    <button type="button" data-quote-comment><Icon name="comment" /> نظر روی این بخش</button>
    <button type="button" data-quote><Icon name="share" /> اشتراک</button>
  </div>
</Base>
