---
import Base from '../layouts/Base.astro';
import Lead from '../components/Lead.astro';
import Timeline from '../components/Timeline.astro';
import Sidebar from '../components/Sidebar.astro';
import Icon from '../components/Icon.astro';
import TodayRail from '../components/TodayRail.astro';
import DailyBrief from '../components/DailyBrief.astro';
import { SITE } from '../site';
import { getFeed, latestDigest, url } from '../lib/posts';

const posts = getFeed();
const digest = latestDigest();
// The morning summary sits on top in full, so it isn't repeated on the timeline.
const first = posts.slice(0, SITE.pageSize).filter((p) => p.id !== digest?.id);
const lead = first.find((p) => p.kind === 'story' && p.cover);
const rest = first.filter((p) => p !== lead);
const next = posts.length > SITE.pageSize ? url('page/2/') : null;
---
<Base image={lead?.cover?.src}>
  <div class="container">
    <h1 class="sr-only">{SITE.name} — {SITE.tagline}</h1>
    <TodayRail />
    {
      posts.length ? (
        <div class="layout">
          <div class="col-main">
            <div class="home-top">
              <Lead post={lead} />
              <DailyBrief />
            </div>
            <Timeline posts={rest} all={posts} nextHref={next} />
          </div>
          <Sidebar />
        </div>
      ) : (
        <div class="empty">
          <Icon name="news" />
          <p>هنوز خبری نیامده. چند دقیقه‌ی دیگر سر بزنید.</p>
        </div>
      )
    }
  </div>
</Base>
