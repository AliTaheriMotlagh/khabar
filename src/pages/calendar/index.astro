---
// «تقویم رویدادها» (PLAN.md P3-5): the dated events the stories announce — launches, conferences, hearings, deadlines —
// each with its story. Only dates a story states (pipeline/ai_more.py `date_said`), never one the model worked out
// from "next week". Upcoming first; the last month's behind a fold. Subscribable as /calendar.ics; the English twin
// is /en/calendar/ (src/components/CalendarView.astro, src/lib/calendar.ts).
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import CalendarView from '../../components/CalendarView.astro';
import { SITE } from '../../site';
import { abs, url } from '../../lib/posts';
import { breadcrumbs } from '../../lib/seo';
import { tehranDay } from '../../lib/time';
import { calEvents, calLinks } from '../../lib/calendar';
import { eventsLd } from '../../lib/calendar-ld';

const today = tehranDay(Date.now());
const upcoming = calEvents('fa').filter((e) => e.date >= today);
const jsonLd = [eventsLd(`تقویم رویدادهای هوش مصنوعی — ${SITE.name}`, abs('calendar/'), upcoming, 'fa-IR'), breadcrumbs([{ name: 'تقویم رویدادها', path: 'calendar/' }])];
---
<Base title="تقویم رویدادهای هوش مصنوعی" alternates={{ en: url('en/calendar/') }} description={`رویدادها، عرضه‌ها و مهلت‌های پیش روی دنیای هوش مصنوعی، هر کدام با خبرش${upcoming[0] ? `: ${upcoming.slice(0, 3).map((e) => e.summary).join('، ')}` : ''}.`} jsonLd={jsonLd}>
  <link slot="head" rel="alternate" type="text/calendar" title={calLinks('fa').name} href={url('calendar.ics')} />
  <div class="container narrow">
    <header class="page-head"><h1><Icon name="clock" /> تقویم رویدادها</h1><p>عرضه‌ها، رویدادها و مهلت‌هایی که خبرها تاریخشان را گفته‌اند.</p></header>
    <CalendarView lang="fa" />
  </div>
</Base>
