---
import '../styles/global.css';
import { SITE } from '../site';
import { abs, feedRev, url } from '../lib/posts';
import { FEEDS, type FeedDef } from '../lib/feed';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Settings from '../components/Settings.astro';
import VoiceOffer from '../components/VoiceOffer.astro';
import VideoSheet from '../components/VideoSheet.astro';
import Chat from '../components/Chat.astro';
import Peek from '../components/Peek.astro';
import Icon from '../components/Icon.astro';
import ListenBar from '../components/ListenBar.astro';
import { EN } from '../lib/en';
import { EN_DAILY, EN_FEEDS } from '../lib/en-feed';

interface Props {
  title?: string;
  description?: string;
  image?: string | null;
  imageAlt?: string;
  type?: 'website' | 'article';
  published?: string;
  modified?: string;
  section?: string;
  tags?: string[];
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
  progress?: boolean;
  /** This page's own feed (a topic's), named before the site's so a reader offers it first. */
  feed?: Pick<FeedDef, 'title' | 'path'>;
  /** A paginated list's neighbours (Bing and readers' "next page" keys still use them). */
  prev?: string | null;
  next?: string | null;
  /** The page's language: Persian (the default, right to left) or the English edition (/en/). */
  lang?: 'fa' | 'en';
  /** The same page in the other language (paths from url()), for hreflang and the language switch. */
  alternates?: { fa?: string | null; en?: string | null };
}
const { lang = 'fa', alternates = {}, title, description: fullDescription = lang === 'en' ? EN.description : SITE.description, image, imageAlt, type = 'website', published, modified, section, tags = [], jsonLd = [], noindex, progress, feed, prev, next } = Astro.props;
const en = lang === 'en';
const siteName = en ? EN.name : SITE.name;
// Search results show about 155 characters: cut at a word, never mid-word, so the snippet reads as a sentence.
const metaCut = (s: string, n = 158) => {
  s = s.replace(/\s+/g, ' ').trim();
  return s.length <= n ? s : s.slice(0, n).replace(/\s+\S*$/, '').replace(/[\s.،,:;؛—-]+$/, '') + '…';
};
const description = metaCut(fullDescription);
// Search consoles verify the site by a meta tag: set PUBLIC_GOOGLE_SITE_VERIFICATION / PUBLIC_BING_SITE_VERIFICATION
// on Vercel (free; no code change needed).
const verify = { google: import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION, bing: import.meta.env.PUBLIC_BING_SITE_VERIFICATION, yandex: import.meta.env.PUBLIC_YANDEX_VERIFICATION };
const feeds = en ? [...(feed ? [feed] : []), EN_FEEDS.all, EN_DAILY] : [...(feed ? [feed] : []), FEEDS.all, FEEDS.news, FEEDS.daily];

// Open pages compare this with /build.json to notice newer news (src/scripts/social.ts).
const rev = feedRev();
const fullTitle = title ? `${title} | ${siteName}` : `${siteName} — ${en ? EN.tagline : SITE.tagline}`;
// Canonical always points at the primary domain, so the GitHub Pages mirror never competes with it in search.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = abs(Astro.url.pathname.slice(base.length));
const ogImage = image ? new URL(image, SITE.url).href : abs('og.png');
const absPage = (h: string) => abs(h.slice(base.length));
// hreflang: this page, and its other-language twin when there is one; x-default is the Persian page (the site's default).
const faHref = en ? (alternates.fa ? absPage(alternates.fa) : null) : canonical;
const enHref = en ? canonical : alternates.en ? absPage(alternates.en) : null;
// The language switch in the header: the twin page, else the other edition's home.
const switchHref = en ? alternates.fa ?? url() : alternates.en ?? url('en/');
const org = {
  '@type': 'NewsMediaOrganization',
  '@id': `${SITE.url}/#org`,
  name: SITE.name,
  alternateName: SITE.nameLatin,
  url: abs(''),
  logo: { '@type': 'ImageObject', url: abs('icon-512.png'), width: 512, height: 512 },
  sameAs: [`https://t.me/${SITE.channel}`, SITE.owner.url],
  founder: { '@type': 'Person', name: SITE.owner.nameLatin, alternateName: SITE.owner.name, url: SITE.owner.url },
};
const ld = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE.url}/#website`,
    name: SITE.name,
    alternateName: SITE.nameLatin,
    url: abs(''),
    inLanguage: ['fa-IR', 'en'],
    publisher: { '@id': `${SITE.url}/#org` },
    potentialAction: { '@type': 'SearchAction', target: `${abs(en ? 'en/investigate/' : 'search/')}?q={query}`, 'query-input': 'required name=query' },
  },
  { '@context': 'https://schema.org', ...org },
  ...jsonLd,
];
---
<!doctype html>
<html lang={en ? 'en' : 'fa'} dir={en ? 'ltr' : 'rtl'} data-alt-lang={switchHref} data-build-latest={rev.latest} data-build-count={rev.count} data-theme="light" data-view="cards" data-media="show" data-size="m" data-spacing="m" data-focus="off">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {faHref && <link rel="alternate" hreflang="fa" href={faHref} />}
    {enHref && <link rel="alternate" hreflang="en" href={enHref} />}
    {faHref && <link rel="alternate" hreflang="x-default" href={faHref} />}
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
    <!-- X/Twitter's video CDN refuses requests that carry a foreign Referer. -->
    <meta name="referrer" content="no-referrer" />
    <meta name="theme-color" content="#f5f6fa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0f17" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    <meta name="author" content={en ? SITE.owner.nameLatin : SITE.owner.name} />
    <meta name="application-name" content={siteName} />
    <meta name="apple-mobile-web-app-title" content={SITE.name} />
    <meta name="apple-mobile-web-app-capable" content="yes" /><meta name="mobile-web-app-capable" content="yes" />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={url('icon-192.png')} />
    <link rel="manifest" href={url('manifest.webmanifest')} />
    {feeds.map((f) => <link rel="alternate" type="application/rss+xml" title={f.title} href={url(f.path)} />)}
    <link rel="sitemap" href={url('sitemap-index.xml')} />
    {prev && <link rel="prev" href={absPage(prev)} />}
    {next && <link rel="next" href={absPage(next)} />}
    {verify.google && <meta name="google-site-verification" content={verify.google} />}
    {verify.bing && <meta name="msvalidate.01" content={verify.bing} />}
    {verify.yandex && <meta name="yandex-verification" content={verify.yandex} />}
    <!-- Pictures come through the image proxy (src/lib/posts.ts, picture()): connect to it before the first one. -->
    <link rel="preconnect" href="https://wsrv.nl" />
    <link rel="dns-prefetch" href="https://video.twimg.com" />
    <slot name="head" />
    <!-- Chrome fetches a page as soon as the reader hovers or starts tapping its link, so it opens instantly. -->
    <script type="speculationrules" is:inline>
      { "prefetch": [{ "source": "document", "where": { "and": [{ "href_matches": "/*" }, { "not": { "href_matches": "/api/*" } }, { "not": { "selector_matches": "[target], [download]" } }] }, "eagerness": "moderate" }] }
    </script>

    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={en ? 'en_US' : 'fa_IR'} />
    {(en ? faHref : enHref) && <meta property="og:locale:alternate" content={en ? 'fa_IR' : 'en_US'} />}
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? siteName} />
    <meta property="og:description" content={metaCut(fullDescription, 300)} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={imageAlt ?? siteName} />
    {!image && <meta property="og:image:width" content="1200" />}
    {!image && <meta property="og:image:height" content="630" />}
    {published && <meta property="article:published_time" content={published} />}
    {modified && <meta property="article:modified_time" content={modified} />}
    {section && <meta property="article:section" content={section} />}
    {tags.map((t) => <meta property="article:tag" content={t} />)}
    {type === 'article' && <meta property="article:author" content={SITE.owner.url} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? siteName} />
    <meta name="twitter:description" content={metaCut(fullDescription, 200)} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt ?? siteName} />
    <meta name="telegram:channel" content={`@${SITE.channel}`} />
    {ld.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}

    <!-- Apply the reader's saved settings before first paint (no theme flash). -->
    <script is:inline>
      (function () {
        var d = document.documentElement, s = {};
        try { s = JSON.parse(localStorage.getItem('khabar:settings') || '{}'); } catch (e) {}
        var t = s.theme || 'auto';
        if (t === 'auto') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        d.dataset.theme = t;
        ['size', 'spacing', 'focus', 'view', 'media'].forEach(function (k) { if (s[k]) d.dataset[k] = s[k]; });
        // A page opened in the player's shell (src/scripts/listen.ts): the bar of the window that plays is shown instead.
        try { if (window.top !== window && window.frameElement && window.frameElement.hasAttribute('data-shell-frame')) d.dataset.framed = ''; } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{en ? 'Skip to content' : 'رفتن به محتوا'}</a>
    {progress && <div class="progress" aria-hidden="true"><i></i></div>}
    <Header lang={lang} switchHref={switchHref} />
    <button class="fresh-pill" type="button" data-fresh hidden><Icon name="sparkles" /> {en ? 'New stories are in — show' : 'خبرهای تازه رسید — نمایش'}</button>
    <div class="offline-bar" data-offline hidden><Icon name="wifi-off" /> {en ? "You're offline — pages you've seen and your saved stories still open." : 'آفلاین هستید — صفحه‌هایی که قبلاً دیده‌اید و ذخیره‌ها در دسترس‌اند.'}</div>
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} switchHref={switchHref} />
    {
      en ? (
        <Settings lang="en" />
      ) : (
        <>
          <ListenBar />
          <Settings />
          <VoiceOffer />
          <VideoSheet />
          <Chat />
          <Peek />
        </>
      )
    }
    <button class="to-top" type="button" aria-label={en ? 'Back to top' : 'بازگشت به بالا'} data-to-top><Icon name="up" /></button>
    <div class="toast" role="status" aria-live="polite" data-toast></div>
    <script>
      import '../scripts/app';
    </script>
  </body>
</html>
